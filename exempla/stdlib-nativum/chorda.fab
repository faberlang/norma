# stdlib-nativum/chorda — chorda v1 subset (cord + UTF-8 mechanical trio)
#
# EXPECTED OUTPUT:
#   amor
#   alpha_beta_gamma
#   2
#   verum
#   Salve
#   Salve

import from "norma:chorda" chorda

main {
    print chorda.reverse("roma")
    print chorda.nexa(["alpha", "beta", "gamma"], "_")
    print chorda.reputat("banana", "an")
    print chorda.reciprocus("anna")
    const bytes raw ← chorda.pange("Salve")
    print chorda.solve(raw)
    const bytes probe ← chorda.pange("Salve")
    print chorda.tempta(probe)
    print chorda.retenta("hello7!", "a", "z")
    print chorda.comprimata("  foo   bar  ")
    print chorda.discissa("a=b=c", "=", 2).first()
}
