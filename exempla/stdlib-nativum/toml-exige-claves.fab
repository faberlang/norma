# stdlib-nativum/toml-exige-claves — multi-key exige_claves
#
# EXPECTED OUTPUT:
#   faber sample

import from "norma:toml" toml
import from "norma:valor" value

fn sampleToml() → string {
    return «name = "faber"
id = "sample"»
}

main {
    const value doc ← toml.solve(sampleToml())

    do {
        value.exige_claves(doc, ["id", "name"])
        const string name ← value.cape(doc, "name") ↦ string ⇥ "missing"
        const string id ← value.cape(doc, "id") ↦ string ⇥ "missing"
        print name, id
    }
    catch err {
        assert false
    }

    do {
        value.exige_claves(doc, ["absent"])
        assert false
    }
    catch err {
        assert err.contains("missing key")
    }
}
