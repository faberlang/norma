# stdlib-nativum/codex — norma:codex encoding/decoding API contract tests
#
# All 9 public functions are deferred via mori. This exemplum verifies:
#   1. Each function can be imported and called
#   2. Each mori body throws

import from "norma:codex" codex

main {
    # -----------------------------------------------------------------------
    # Base64 — mori deferred
    # -----------------------------------------------------------------------
    do {
        codex.base64(|61 62 63|)
        assert false
    }
    catch err {
        print err
    }

    do {
        codex.deBase64("AQID")
        assert false
    }
    catch err {
        print err
    }

    do {
        codex.temptaBase64("AQID")
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # Hex — mori deferred
    # -----------------------------------------------------------------------
    do {
        codex.hex(|61 62 63|)
        assert false
    }
    catch err {
        print err
    }

    do {
        codex.deHex("616263")
        assert false
    }
    catch err {
        print err
    }

    do {
        codex.temptaHex("616263")
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # URL encoding — mori deferred
    # -----------------------------------------------------------------------
    do {
        codex.url("hello world")
        assert false
    }
    catch err {
        print err
    }

    do {
        codex.deUrl("hello+world")
        assert false
    }
    catch err {
        print err
    }

    do {
        codex.urlComponentum("a&b=c")
        assert false
    }
    catch err {
        print err
    }

    do {
        codex.deUrlComponentum("a%26b%3Dc")
        assert false
    }
    catch err {
        print err
    }
}
