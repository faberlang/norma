+++

# stdlib-nativum/consolum — norma:consolum console I/O API contract tests
#
# All 17 public functions are ad-routed. This exemplum verifies:
#   1. Import works
#   2. Each function can be called (host routes unavailable at test time)

import from "norma:consolum" consolum

main {
    # -----------------------------------------------------------------------
    # STDIN - Bytes
    # -----------------------------------------------------------------------
    do {
        consolum.hauri(16)
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.hauriet(16)
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # STDIN - Text
    # -----------------------------------------------------------------------
    do {
        consolum.lege()
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.leget()
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # STDOUT - Bytes
    # -----------------------------------------------------------------------
    do {
        consolum.funde(|01 02 03|)
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.fundet(|01 02 03|)
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # STDOUT - Text
    # -----------------------------------------------------------------------
    do {
        consolum.scribe("test-output")
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.scribet("test-async")
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.dic("partial")
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.dicet("partial-async")
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # STDERR - Warning and Debug
    # -----------------------------------------------------------------------
    do {
        consolum.mone("warn-output")
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.monet("warn-async")
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.vide("debug-output")
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.videbit("debug-async")
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # TTY Detection
    # -----------------------------------------------------------------------
    do {
        consolum.audit()
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.loquitur()
        assert false
    }
    catch err {
        print err
    }

    do {
        consolum.admonet()
        assert false
    }
    catch err {
        print err
    }
}
