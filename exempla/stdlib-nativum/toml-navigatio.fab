+++
term = "toml"
kind = "existing-home"
category = "stdlib"
canonical = false
summary = "Native valor navigation over parsed TOML (cape, inveni, exige)."
syntax = "toml.solve | valor.cape | valor.inveni | valor.exige"
related = ["valor", "toml", "stdlib-nativum"]
locale = "en"
+++
# stdlib-nativum/toml-navigatio — native valor tree walk over parsed TOML
#
# EXPECTED OUTPUT:
#   faber, 1, sample

import from "norma:toml" toml
import from "norma:valor" value

fn sampleToml() → string {
    return «name = "faber"
version = 1
id = "sample"»
}

main {
    const value doc ← toml.solve(sampleToml())

    assert value.tabulane(doc)
    assert value.textusne(value.cape(doc, "name"))
    assert value.numerusne(value.cape(doc, "version"))
    assert value.nihilne(doc) ≡ false

    const string name ← value.cape(doc, "name") ↦ string ⇥ "missing"
    const int version ← value.cape(doc, "version") ↦ int ⇥ 0
    const string id ← value.inveni(doc, "id") ↦ string ⇥ "missing"

    do {
        const string required ← value.exige(doc, "id")
        assert required ≡ "sample"
    }
    catch err {
        assert false
    }

    assert name ≡ "faber"
    assert version ≡ 1
    assert id ≡ "sample"

    do {
        value.exige(doc, "absent")
        assert false
    }
    catch err {
        assert err.contains("missing key")
    }

    print name, version, id
}
