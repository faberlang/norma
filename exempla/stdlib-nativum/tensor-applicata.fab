# stdlib-nativum/tensor-applicata — loop-based map and intrinsic-backed sum
#
# EXPECTED OUTPUT:
#   14

import from "norma:tensor" tensor

main {
    const list<int> flat ← [1, 2, 3, 4]
    const tensor<int, [2, 2]> grid ← tensor.structa<tensor<int, [2, 2]>>(flat)
    const tensor<int, [2, 2]> scaled ← tensor.applicata(grid, int x ∴ x + 1)
    const int total ← tensor.sum(scaled)
    print total
}
