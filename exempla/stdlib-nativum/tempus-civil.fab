+++
term = "tempus"
kind = "concept"
category = "stdlib"
canonical = false
summary = "norma:tempus wire catalog, civil projection, strict structa."
syntax = "norma:tempus — solve | exprimit | annus | structa"
related = ["instans", "stdlib-nativum", "tempus"]
locale = "en"
+++
# stdlib-nativum/tempus-civil — norma:tempus wire + civil surface
#
# EXPECTED OUTPUT:
#   1979-05-27T07:32:00Z
#   verum

import from "norma:tempus" tempus

fn epochZero() → instant {
    return "1970-01-01T00:00:00Z" ↦ instant
}

fn build(int y, int m, int d) → instant {
    do {
        return tempus.structa(y, m, d)
    }
    catch err {
        return epochZero()
    }
}

fn buildMoment(int y, int m, int d, int h, int min, int s) → instant {
    do {
        return tempus.structa_momenti(y, m, d, h, min, s)
    }
    catch err {
        return epochZero()
    }
}

fn expectInvalid() → bool {
    do {
        const _ bad ← tempus.structa(2026, 2, 30)
        return false
    }
    catch err {
        return true
    }
}

main {
    const instant t ← tempus.solve("1979-05-27T07:32:00Z")
    assert tempus.exprimit(t) ≡ "1979-05-27T07:32:00Z"
    assert tempus.annus(t) ≡ 1979
    assert tempus.mensis(t) ≡ 5
    assert tempus.dies(t) ≡ 27
    assert tempus.hora(t) ≡ 7
    assert tempus.minuta(t) ≡ 32
    assert tempus.secunda(t) ≡ 0

    const instant rebuilt ← buildMoment(1979, 5, 27, 7, 32, 0)
    assert (rebuilt ↦ instant<ms>) ≡ (t ↦ instant<ms>)

    const instant leap ← build(2024, 2, 29)
    assert tempus.mensis(leap) ≡ 2
    assert tempus.dies(leap) ≡ 29
    assert expectInvalid()

    # -----------------------------------------------------------------------
    # structa: year=0 (out of range)
    # -----------------------------------------------------------------------
    do {
        const instant bad ← tempus.structa(0, 1, 1)
        assert false
    }
    catch err {
        assert err.length() > 0
    }

    # -----------------------------------------------------------------------
    # structa: invalid month (month=13)
    # -----------------------------------------------------------------------
    do {
        const instant bad ← tempus.structa(2026, 13, 1)
        assert false
    }
    catch err {
        assert err.length() > 0
    }

    # -----------------------------------------------------------------------
    # structa: month=0 (out of range)
    # -----------------------------------------------------------------------
    do {
        const instant bad ← tempus.structa(2026, 0, 1)
        assert false
    }
    catch err {
        assert err.length() > 0
    }

    # -----------------------------------------------------------------------
    # structa_momenti: invalid hour (hour=25)
    # -----------------------------------------------------------------------
    do {
        const instant bad ← tempus.structa_momenti(2026, 1, 1, 25, 0, 0)
        assert false
    }
    catch err {
        assert err.length() > 0
    }

    # -----------------------------------------------------------------------
    # structa_momenti: invalid minute (minute=60)
    # -----------------------------------------------------------------------
    do {
        const instant bad ← tempus.structa_momenti(2026, 1, 1, 0, 60, 0)
        assert false
    }
    catch err {
        assert err.length() > 0
    }

    # -----------------------------------------------------------------------
    # structa_momenti: invalid second (second=61)
    # -----------------------------------------------------------------------
    do {
        const instant bad ← tempus.structa_momenti(2026, 1, 1, 0, 0, 61)
        assert false
    }
    catch err {
        assert err.length() > 0
    }

    # -----------------------------------------------------------------------
    # solve: invalid wire format (non-RFC3339)
    # -----------------------------------------------------------------------
    do {
        const instant bad ← tempus.solve("not-a-date")
        assert false
    }
    catch err {
        assert err.length() > 0
    }

    print tempus.exprimit(t)
}
