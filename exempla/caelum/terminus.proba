# caelum/terminus.proba — tests for TCP endpoint type

import from "norma:caelum/terminus" terminus

describe "terminus_construction" {
    test "hospes and portus round-trip" {
        const terminus.Terminus t ← terminus.Terminus { hospes = "127.0.0.1", portus = 8080 }
        assert t.hospes ≡ "127.0.0.1"
        assert t.portus ≡ 8080
    }
}

describe "terminus_different_endpoints" {
    test "different endpoints" {
        const terminus.Terminus local ← terminus.Terminus { hospes = "127.0.0.1", portus = 8080 }
        const terminus.Terminus remote ← terminus.Terminus { hospes = "192.168.1.1", portus = 443 }
        assert local.hospes ≠ remote.hospes
        assert local.portus ≠ remote.portus
    }
}
