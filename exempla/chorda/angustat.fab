+++
term = "chorda"
kind = "concept"
category = "stdlib"
canonical = false
summary = "Trust-boundary narrowing and whitespace cleanup on cords."
syntax = "temptat(<cord>) | comprimata(<cord>) | angustata(<cord>)"
related = ["stdlib-nativum", "textus", "ascii"]
locale = "en"
+++


# chorda/angustata — trust-boundary narrowing and whitespace cleanup
#
# `angustata` (failable `ascii ⇥ textus`) is covered in `crates/norma/chorda_test.rs`.
# This exemplum exercises `temptat` and `comprimata` on the package path.

import from "norma:chorda" chorda

main {
    const ascii ∪ null present ← chorda.temptat("Authorization")
    assert present ≠ null

    const ascii ∪ null absent ← chorda.temptat("π")
    assert absent ≡ null

    const string neat ← chorda.comprimata("  foo   bar  ")
    assert neat ≡ "foo bar"

    print neat
}
