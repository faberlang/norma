+++
term = "chorda"
kind = "concept"
category = "stdlib"
canonical = false
summary = "Assertion-based tests for chorda UTF-8 mechanical trio: pange, solve, tempta."
syntax = "pange | solve | tempta"
related = ["chorda", "textus", "octeti", "stdlib-nativum"]
locale = "en"
+++

# chorda/mechanica — UTF-8 mechanical trio contract tests
#
# pange: textus → octeti (UTF-8 encode)
# solve: octeti → textus (UTF-8 decode, throws on invalid)
# tempta: octeti → textus ∪ nihil (tries decode, returns nihil on invalid)
#
# All three are mori-deferred (Stage 2). Tests verify they throw
# and the mori error can be inspected.

import from "norma:chorda" chorda

main {
    # -----------------------------------------------------------------------
    # pange — UTF-8 encode (mori deferred)
    # -----------------------------------------------------------------------
    do {
        const bytes raw ← chorda.pange("Salve")
        assert false
    }
    catch err {
        print err
    }

    do {
        const bytes raw ← chorda.pange("")
        assert false
    }
    catch err {
        print err
    }

    do {
        const bytes raw ← chorda.pange("π ≈ 3.14")
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # solve — UTF-8 decode (mori deferred)
    # -----------------------------------------------------------------------
    do {
        const string decoded ← chorda.solve(|68 65 6c 6c 6f|)
        assert false
    }
    catch err {
        print err
    }

    do {
        const string decoded ← chorda.solve(|ce bb|)
        assert false
    }
    catch err {
        print err
    }

    # -----------------------------------------------------------------------
    # tempta — try UTF-8 decode (mori deferred)
    # -----------------------------------------------------------------------
    do {
        const string ∪ null decoded ← chorda.tempta(|68 65 6c 6c 6f|)
        assert false
    }
    catch err {
        print err
    }

    do {
        const string ∪ null decoded ← chorda.tempta(|ff fe|)
        assert false
    }
    catch err {
        print err
    }
}
