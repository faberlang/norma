+++
locale = "en"
+++

# check-generated-output — reject tracked `target/` output paths
#
# Native-Faber conversion of scripta/check-generated-output (bash):
# runs `git ls-files` via captura, filters paths, and rejects committed
# `target/` entries with the same exit semantics as the shell version
# (exit 1 if any tracked path matches `target/*` or `*/target/*`, else 0).

import from "faber:processus" processus
import from "faber:consolum" consolum

main {
    const string root ← processus.sedes() ↦ string
    const map<string, value> result ← processus.captura(["git", "-C", root, "ls-files"]) ↦ map<string, value>
    const string tracked ← result["stdout"] ↦ string

    var int status ← 0
    var int pos ← 0
    while pos < tracked.length() {
        var int end ← pos
        while end < tracked.length() and tracked.slice(end, end + 1) ≠ "\n" {
            end ← end + 1
        }
        const string file ← tracked.slice(pos, end)
        if file.starts_with("target/") or file.contains("/target/") {
            consolum.mone("check-generated-output: tracked generated output is not allowed: " + file)
            status ← 1
        }
        pos ← end + 1
    }
    processus.exi(status)
}
