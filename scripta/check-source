#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"
# Prefer the in-workspace radix binary. Sibling path is the direct checkout
# (faberlang/norma → faberlang/radix). Container path is a worktree packet
# (worktrees/<lane>/norma → faberlang/radix). FABER still wins when set.
if [[ -z "${FABER:-}" ]]; then
  if [[ -x "$ROOT/../radix/target/debug/faber" ]]; then
    FABER="$ROOT/../radix/target/debug/faber"
  elif [[ -x "$ROOT/../../../radix/target/debug/faber" ]]; then
    FABER="$ROOT/../../../radix/target/debug/faber"
  else
    FABER="$ROOT/../radix/target/debug/faber"
  fi
fi
export FABER
status=0

# Declaration names must not collide with reserved en keywords, types, or
# frame variants. This is the surviving english-locale guard: pre-rename
# Latin spellings are no longer grepped (the compiler owns that rejection
# through ordinary unknown-name/unknown-member diagnostics).
PASS_B_RESERVED='^(fn|class|interface|union|enum|type)[[:space:]]+(fn|class|union|enum|type|const|let|var|import|from|as|public|private|optional|return|if|else|elif|then|for|while|match|case|break|continue|throw|catch|do|assert|panic|true|false|null|and|or|not|is|self|main|print|test|read|write|warn|debug|size|name|step|range|between|within|until|line|args|call|await|async|future|format|require|exit|string|int|bool|float|list|map|set|bytes|value|void|unknown|null_ty|instant|json|object|any|promise|iterator|tensor|vector|matrix|ascii|request|item|byte|bulk|done|error|cancel)\b'

if [[ ! -d "$SRC" ]]; then
  echo "check-source: missing src directory: $SRC" >&2
  exit 1
fi

# Interface root allows product `*.fab` and test-only `*.proba` (never published
# as package interface surface — cista install copies `*.fab` only). Any other
# non-interface file under src/ is rejected so the snapshot stays clean.
while IFS= read -r -d '' file; do
  rel="${file#$SRC/}"
  echo "check-source: non-interface file under src/: $rel" >&2
  echo "check-source: cista snapshots src/ as the package interface root; keep only *.fab (product) and *.proba (test-only)" >&2
  status=1
done < <(find "$SRC" -type d -name target -prune -o -type f ! -name '*.fab' ! -name '*.proba' -print0)

while IFS= read -r -d '' file; do
  if grep -nE '^[[:space:]]*//' "$file"; then
    echo "check-source: line-start comments are not allowed in $file" >&2
    status=1
  fi

  if grep -nE '\bad[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\{' "$file"; then
    echo "check-source: route calls must use canonical string route syntax in $file" >&2
    status=1
  fi

  if grep -nE "$PASS_B_RESERVED" "$file"; then
    echo "check-source: declaration collides with a reserved en keyword/type/frame variant in $file" >&2
    status=1
  fi
done < <(find "$SRC" \( -name '*.fab' -o -name '*.proba' \) -print0)

# Kernel-script gates run from a manifest-free staged copy: an in-tree path
# sits below faber.toml and routes to package mode, which rejects faber:*
# kernel imports (docs/factory/provider-source-claim-matrix.md, Validation
# Commands).
stage="$(mktemp -d)"
cp "$ROOT/scripta/check-promoted-helper-imports.fab" "$stage/"
cp "$ROOT/scripta/check-generated-output.fab" "$stage/"
export FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"
(cd "$ROOT" && "$FABER" run "$stage/check-promoted-helper-imports.fab") || status=1
(cd "$ROOT" && "$FABER" run "$stage/check-generated-output.fab") || status=1
rm -f "$stage/check-promoted-helper-imports.fab" "$stage/check-generated-output.fab"
rmdir "$stage"

exit "$status"
