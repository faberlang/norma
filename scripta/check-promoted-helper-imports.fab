+++
locale = "en"
+++

# check-promoted-helper-imports — validate the promoted-helper matrix row
# via `faber check` import smoke on generated temp `.fab` files.
#
# Native-Faber conversion of scripta/check-promoted-helper-imports (bash):
# same pass/fail decisions — the matrix row must list every promoted module
# (backtick-wrapped), must not list parked/compile-gap modules, and each
# promoted module must pass a `faber check` import smoke.

importa ex "faber:processus" privata processus
importa ex "faber:solum" privata solum
importa ex "faber:consolum" privata consolum

# First row of the document starting with the promoted-helper matrix header.
functio find_promoted_row(textus via) → textus {
    fixum lista<valor> rows ← solum.carpe(via) ↦ lista<valor>
    fixum numerus n ← rows.longitudo()
    varia numerus idx ← 0
    dum idx < n {
        fixum textus row ← rows[idx] ↦ textus
        si row.initium("| Compile/import-evidenced native helpers |") {
            redde row
        }
        idx ← idx + 1
    }
    redde ""
}

incipit {
    fixum textus root ← processus.sedes() ↦ textus

    # FABER and FABER_LIBRARY_HOME overrides, matching ${VAR:-default}
    fixum tabula<textus, valor> fr ← processus.captura(["sh", "-c", "printf '%s' \"$FABER\""]) ↦ tabula<textus, valor>
    fixum textus faber_env ← fr["stdout"] ↦ textus
    varia textus faber ← root + "/../faber/target/debug/faber"
    si faber_env.longitudo() > 0 {
        faber ← faber_env
    }
    fixum tabula<textus, valor> lr ← processus.captura(["sh", "-c", "printf '%s' \"$FABER_LIBRARY_HOME\""]) ↦ tabula<textus, valor>
    fixum textus lib_env ← lr["stdout"] ↦ textus
    varia textus lib_home ← root + "/.."
    si lib_env.longitudo() > 0 {
        lib_home ← lib_env
    }

    # Executable check for the pinned faber binary
    si solum.exstat(faber) ↦ bivalens est falsum {
        consolum.mone("check-promoted-helper-imports: missing executable faber at " + faber)
        processus.exi(1)
    }
    fixum numerus mode ← solum.modus(faber) ↦ numerus
    si (mode ∧ 64) ≡ 0 et (mode ∧ 8) ≡ 0 et (mode ∧ 1) ≡ 0 {
        consolum.mone("check-promoted-helper-imports: missing executable faber at " + faber)
        processus.exi(1)
    }

    # Matrix row validation
    fixum textus matrix ← root + "/docs/factory/provider-source-claim-matrix.md"
    fixum textus promoted_row ← find_promoted_row(matrix)
    si promoted_row.longitudo() ≡ 0 {
        consolum.mone("check-promoted-helper-imports: missing promoted helper matrix row")
        processus.exi(1)
    }

    fixum textus tick ← "\`".sectio(1, 2)

    fixum lista<textus> promoted ← ["csv", "json", "json/pange", "json/solve", "json/cursor", "json/lexica", "model", "tensor", "valor", "vector", "chorda", "tempus", "solum/path"]
    fixum lista<textus> parked ← ["fila", "ordinata", "mathesis"]

    itera ex promoted fixum module {
        si not (promoted_row.continet(tick + module + tick)) {
            consolum.mone("check-promoted-helper-imports: matrix row missing promoted module " + module)
            processus.exi(1)
        }
    }
    itera ex parked fixum module {
        si promoted_row.continet(tick + module + tick) {
            consolum.mone("check-promoted-helper-imports: parked/compile-gap module " + module + " is listed as promoted")
            processus.exi(1)
        }
    }

    # Import smoke: run `faber check` on a generated temp .fab per module
    processus.scribe("FABER_LIBRARY_HOME", lib_home)
    fixum textus tmp ← solum.temporarium() ↦ textus
    fixum numerus pid ← processus.identitas() ↦ numerus
    fixum textus pid_s ← pid ↦ textus
    varia numerus status ← 0

    itera ex promoted fixum module {
        varia textus safe ← ""
        varia numerus i ← 0
        dum i < module.longitudo() {
            fixum textus c ← module.sectio(i, i + 1)
            si c ≡ "/" {
                safe ← safe + "_"
            } secus {
                safe ← safe + c
            }
            i ← i + 1
        }
        fixum textus file ← tmp + "/check-promoted-helper-imports-" + pid_s + "-" + safe + ".fab"
        solum.scribe(file, "importa ex \"norma:" + module + "\" privata m\nincipit { }\n")
        fixum tabula<textus, valor> check ← processus.captura([faber, "check", file]) ↦ tabula<textus, valor>
        fixum numerus check_status ← check["status"] ↦ numerus
        fixum textus check_stdout ← check["stdout"] ↦ textus
        fixum textus check_stderr ← check["stderr"] ↦ textus
        solum.dele(file)
        si check_status ≡ 0 {
            nota "ok: norma:" + module
        } secus {
            consolum.mone("check-promoted-helper-imports: failed import smoke for norma:" + module)
            si check_stdout.longitudo() > 0 {
                consolum.mone(check_stdout)
            }
            si check_stderr.longitudo() > 0 {
                consolum.mone(check_stderr)
            }
            status ← 1
        }
    }
    processus.exi(status)
}
