+++
locale = "en"
+++

# check-promoted-helper-imports — validate the promoted-helper matrix row
# via `faber check` import smoke on generated temp `.fab` files.
#
# Native-Faber conversion of scripta/check-promoted-helper-imports (bash):
# the matrix row must list every promoted module (backtick-wrapped), every
# listed module must resolve in the live corpus (norma/src/<module>.fab —
# fail-closed, so a corpus rename breaks this gate loudly instead of
# silently carrying a deleted name), and each promoted module must pass a
# `faber check` import smoke.
#
# The parked/compile-gap list was removed 2026-09-17: all four parked names
# were deleted by the R100 rename (5fc2645) and the compile gap closed
# (matrix compile-gap row flipped green). deque/ordered_map stay
# design-parked in the matrix only; this gate does not enforce that row.
#
# Kernel verbs use the English kernel-manifest surface (v0.84.0): cwd,
# read_lines, write_file, exists, mode, temp_dir, delete, pid,
# exit_process, warn_line, captura. write_env is retired from the kernel
# surface (hosts dropped processus:scribe 7098458, norma wrapper removed
# b62153e), so the smoke passes FABER_LIBRARY_HOME per invocation through
# /usr/bin/env.

import from "faber:processus" processus
import from "faber:solum" solum
import from "faber:consolum" consolum

# First row of the document starting with the promoted-helper matrix header.
fn find_promoted_row(string via) → string {
    const list<value> rows ← solum.read_lines(via) ↦ list<value>
    const int n ← rows.length()
    var int idx ← 0
    while idx < n {
        const string row ← rows[idx] ↦ string
        if row.starts_with("| Compile/import-evidenced native helpers |") {
            return row
        }
        idx ← idx + 1
    }
    return ""
}

main {
    const string root ← processus.cwd() ↦ string

    # FABER and FABER_LIBRARY_HOME overrides, matching ${VAR:-default}.
    # Default is the in-workspace radix binary (sibling, then container).
    const map<string, value> fr ← processus.captura(["sh", "-c", "printf '%s' \"$FABER\""]) ↦ map<string, value>
    const string faber_env ← fr["stdout"] ↦ string
    var string faber ← root + "/../radix/target/debug/faber"
    if faber_env.length() > 0 {
        faber ← faber_env
    }
    if faber_env.length() ≡ 0 {
        if solum.exists(faber) ↦ bool ≡ false {
            const string container ← root + "/../../../radix/target/debug/faber"
            if solum.exists(container) ↦ bool {
                faber ← container
            }
        }
    }
    const map<string, value> lr ← processus.captura(["sh", "-c", "printf '%s' \"$FABER_LIBRARY_HOME\""]) ↦ map<string, value>
    const string lib_env ← lr["stdout"] ↦ string
    var string lib_home ← root + "/.."
    if lib_env.length() > 0 {
        lib_home ← lib_env
    }

    # Executable check for the pinned faber binary
    if solum.exists(faber) ↦ bool ≡ false {
        consolum.warn_line("check-promoted-helper-imports: missing executable faber at " + faber)
        processus.exit_process(1)
    }
    const int mode ← solum.mode(faber) ↦ int
    if (mode ∧ 64) ≡ 0 and (mode ∧ 8) ≡ 0 and (mode ∧ 1) ≡ 0 {
        consolum.warn_line("check-promoted-helper-imports: missing executable faber at " + faber)
        processus.exit_process(1)
    }

    # Matrix row validation
    const string matrix ← root + "/docs/factory/provider-source-claim-matrix.md"
    const string promoted_row ← find_promoted_row(matrix)
    if promoted_row.length() ≡ 0 {
        consolum.warn_line("check-promoted-helper-imports: missing promoted helper matrix row")
        processus.exit_process(1)
    }

    const string tick ← "\`".slice(1, 2)

    const list<string> promoted ← ["csv", "json", "json/solve", "json/cursor", "json/lexer", "model", "tensor", "value", "vector", "text", "time", "fs/path"]

    for from promoted const module {
        # Fail-closed corpus resolution: a listed module that no longer
        # exists in the live corpus aborts before the smoke runs.
        const string corpus_file ← lib_home + "/norma/src/" + module + ".fab"
        if solum.exists(corpus_file) ↦ bool ≡ false {
            consolum.warn_line("check-promoted-helper-imports: listed module norma:" + module + " does not resolve in the live corpus (missing " + corpus_file + ")")
            processus.exit_process(1)
        }
        if not (promoted_row.contains(tick + module + tick)) {
            consolum.warn_line("check-promoted-helper-imports: matrix row missing promoted module " + module)
            processus.exit_process(1)
        }
    }

    # Import smoke: run `faber check` on a generated temp .fab per module.
    # write_env is retired from the kernel surface, so each child gets
    # FABER_LIBRARY_HOME through /usr/bin/env (argv vector, no shell
    # quoting).
    const string tmp ← solum.temp_dir() ↦ string
    const int pid ← processus.pid() ↦ int
    const string pid_s ← pid ↦ string
    var int status ← 0

    for from promoted const module {
        var string safe ← ""
        var int i ← 0
        while i < module.length() {
            const string c ← module.slice(i, i + 1)
            if c ≡ "/" {
                safe ← safe + "_"
            } else {
                safe ← safe + c
            }
            i ← i + 1
        }
        const string file ← tmp + "/check-promoted-helper-imports-" + pid_s + "-" + safe + ".fab"
        solum.write_file(file, "import from \"norma:" + module + "\" m\nmain { }\n")
        const map<string, value> check ← processus.captura(["/usr/bin/env", "FABER_LIBRARY_HOME=" + lib_home, faber, "check", file]) ↦ map<string, value>
        const int check_status ← check["status"] ↦ int
        const string check_stdout ← check["stdout"] ↦ string
        const string check_stderr ← check["stderr"] ↦ string
        solum.delete(file)
        if check_status ≡ 0 {
            print "ok: norma:" + module
        } else {
            consolum.warn_line("check-promoted-helper-imports: failed import smoke for norma:" + module)
            if check_stdout.length() > 0 {
                consolum.warn_line(check_stdout)
            }
            if check_stderr.length() > 0 {
                consolum.warn_line(check_stderr)
            }
            status ← 1
        }
    }
    processus.exit_process(status)
}
