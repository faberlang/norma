+++
locale = "en"
+++

# check-promoted-helper-imports — validate the promoted-helper matrix row
# via `faber check` import smoke on generated temp `.fab` files.
#
# Native-Faber conversion of scripta/check-promoted-helper-imports (bash):
# same pass/fail decisions — the matrix row must list every promoted module
# (backtick-wrapped), must not list parked/compile-gap modules, and each
# promoted module must pass a `faber check` import smoke.

import from "faber:processus" processus
import from "faber:solum" solum
import from "faber:consolum" consolum

# First row of the document starting with the promoted-helper matrix header.
fn find_promoted_row(string via) → string {
    const list<value> rows ← solum.carpe(via) ↦ list<value>
    const int n ← rows.length()
    var int idx ← 0
    while idx < n {
        const string row ← rows[idx] ↦ string
        if row.starts_with("| Compile/import-evidenced native helpers |") {
            return row
        }
        idx ← idx + 1
    }
    return ""
}

main {
    const string root ← processus.sedes() ↦ string

    # FABER and FABER_LIBRARY_HOME overrides, matching ${VAR:-default}.
    # Default is the in-workspace radix binary (sibling, then container).
    const map<string, value> fr ← processus.captura(["sh", "-c", "printf '%s' \"$FABER\""]) ↦ map<string, value>
    const string faber_env ← fr["stdout"] ↦ string
    var string faber ← root + "/../radix/target/debug/faber"
    if faber_env.length() > 0 {
        faber ← faber_env
    }
    if faber_env.length() ≡ 0 {
        if solum.exstat(faber) ↦ bool is false {
            const string container ← root + "/../../../radix/target/debug/faber"
            if solum.exstat(container) ↦ bool {
                faber ← container
            }
        }
    }
    const map<string, value> lr ← processus.captura(["sh", "-c", "printf '%s' \"$FABER_LIBRARY_HOME\""]) ↦ map<string, value>
    const string lib_env ← lr["stdout"] ↦ string
    var string lib_home ← root + "/.."
    if lib_env.length() > 0 {
        lib_home ← lib_env
    }

    # Executable check for the pinned faber binary
    if solum.exstat(faber) ↦ bool is false {
        consolum.mone("check-promoted-helper-imports: missing executable faber at " + faber)
        processus.exi(1)
    }
    const int mode ← solum.modus(faber) ↦ int
    if (mode ∧ 64) ≡ 0 and (mode ∧ 8) ≡ 0 and (mode ∧ 1) ≡ 0 {
        consolum.mone("check-promoted-helper-imports: missing executable faber at " + faber)
        processus.exi(1)
    }

    # Matrix row validation
    const string matrix ← root + "/docs/factory/provider-source-claim-matrix.md"
    const string promoted_row ← find_promoted_row(matrix)
    if promoted_row.length() ≡ 0 {
        consolum.mone("check-promoted-helper-imports: missing promoted helper matrix row")
        processus.exi(1)
    }

    const string tick ← "\`".slice(1, 2)

    const list<string> promoted ← ["csv", "json", "json/solve", "json/cursor", "json/lexica", "model", "tensor", "valor", "vector", "chorda", "tempus", "solum/path"]
    const list<string> parked ← ["fila", "ordinata", "mathesis", "json/pange"]

    for from promoted const module {
        if not (promoted_row.contains(tick + module + tick)) {
            consolum.mone("check-promoted-helper-imports: matrix row missing promoted module " + module)
            processus.exi(1)
        }
    }
    for from parked const module {
        if promoted_row.contains(tick + module + tick) {
            consolum.mone("check-promoted-helper-imports: parked/compile-gap module " + module + " is listed as promoted")
            processus.exi(1)
        }
    }

    # Import smoke: run `faber check` on a generated temp .fab per module
    processus.scribe("FABER_LIBRARY_HOME", lib_home)
    const string tmp ← solum.temporarium() ↦ string
    const int pid ← processus.identitas() ↦ int
    const string pid_s ← pid ↦ string
    var int status ← 0

    for from promoted const module {
        var string safe ← ""
        var int i ← 0
        while i < module.length() {
            const string c ← module.slice(i, i + 1)
            if c ≡ "/" {
                safe ← safe + "_"
            } else {
                safe ← safe + c
            }
            i ← i + 1
        }
        const string file ← tmp + "/check-promoted-helper-imports-" + pid_s + "-" + safe + ".fab"
        solum.scribe(file, "import from \"norma:" + module + "\" m\nmain { }\n")
        const map<string, value> check ← processus.captura([faber, "check", file]) ↦ map<string, value>
        const int check_status ← check["status"] ↦ int
        const string check_stdout ← check["stdout"] ↦ string
        const string check_stderr ← check["stderr"] ↦ string
        solum.dele(file)
        if check_status ≡ 0 {
            print "ok: norma:" + module
        } else {
            consolum.mone("check-promoted-helper-imports: failed import smoke for norma:" + module)
            if check_stdout.length() > 0 {
                consolum.mone(check_stdout)
            }
            if check_stderr.length() > 0 {
                consolum.mone(check_stderr)
            }
            status ← 1
        }
    }
    processus.exi(status)
}
