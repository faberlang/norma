+++
locale = "en"
+++

# audit-provider-route-claims — cross-check Norma source call routes against
# host provider manifests and Rust dispatch.
#
# Native-Faber script (converted from the python3 original, then moved to the
# current surface: en keywords, v0.84.0 kernel verbs, and `call 'route'`
# claims — the english-locale Pass A renamed the `ad` route-call spelling in
# src, so the scanner tracks the live source surface).
#
# Kernel script: imports faber:solum, faber:json, faber:processus,
# faber:consolum, so it must run manifest-free — a path under faber.toml
# routes to package mode, which rejects faber:* kernel imports:
#   stage=$(mktemp -d) && cp scripta/audit-provider-route-claims.fab "$stage/"
#   FABER_LIBRARY_HOME="$(pwd)/.." faber run "$stage/audit-provider-route-claims.fab"
# (workspace radix binary; NEVER ~/.local/bin/faber).
#
# Same findings + exit contract as the Python original: exit 0 when every
# source `call 'route'` family matches its provider manifest.json and every
# manifest route appears in the matching Rust dispatch match; exit 1 on any
# finding. Exactly one manifest-only exception is admitted by name:
# solum:digestio (streamed SHA-256 file digest, hosts 5a52ee52) is a
# deliberate direct-host capability — the file-streaming admission seam
# (Vivi 8a08bd23), distinct from norma:crypta.digest — so Norma claims no
# route and ships no wrapper for it. The exception exempts it from the
# source-claim requirement only; manifest-to-dispatch checking still
# applies, and the exception fails closed the moment the route leaves the
# provider manifest. The default subject is the LIVE hosts HEAD: ../hosts is
# resolved
# at audit time, the audit assesses current hosts, and the examined revision
# is recorded in its report (`hosts: rev=...`). `--expected-rev <sha>` is the
# explicit historical pin — use it to re-verify a recorded evidence state
# (for example the e066ee0 provider-evidence snapshot); the audit then fails
# on any other revision. In both modes the provider evidence repo must have a
# clean checkout/index.
# `processus:exi` is an intentional source-only exclusion until host exit has
# a protocol-visible terminal response.

import from "faber:processus" processus
import from "faber:solum" solum
import from "faber:consolum" consolum
import from "faber:json" json

# ===========================================================================
# LIST HELPERS (kernel lists are dynamic values; index loops only)
# ===========================================================================

fn contains_route(list<string> xs, string x) → bool {
    const int n ← xs.length()
    var int i ← 0
    while i ≺ n {
        if xs[i] ≡ x {
            return true
        }
        i ← i + 1
    }
    return false
}

fn difference(list<string> a, list<string> b) → list<string> {
    var list<string> out ← empty
    const int n ← a.length()
    var int i ← 0
    while i ≺ n {
        if contains_route(b, a[i]) ≡ false {
            out.append(a[i])
        }
        i ← i + 1
    }
    return out
}

fn intersect(list<string> a, list<string> b) → list<string> {
    var list<string> out ← empty
    const int n ← a.length()
    var int i ← 0
    while i ≺ n {
        if contains_route(b, a[i]) {
            out.append(a[i])
        }
        i ← i + 1
    }
    return out
}

# Whether any collected line contains the needle (self-test stderr checks).
fn lines_contain(list<string> lines, string needle) → bool {
    const int n ← lines.length()
    var int i ← 0
    while i ≺ n {
        if lines[i].contains(needle) {
            return true
        }
        i ← i + 1
    }
    return false
}

# ===========================================================================
# SOURCE ROUTES (rglob('*.fab') + `\bcall\s+'([^']+)'`)
# ===========================================================================

fn collect_fab(string dir) → list<string> ⇥ string {
    var list<string> out ← empty
    const list<string> names ← solum.list_dir(dir) ↦ list<string>
    const list<string> sorted ← names.sorted() ↦ list<string>
    const int n ← sorted.length()
    var int i ← 0
    while i ≺ n {
        const string name ← sorted[i]
        const string path ← dir + "/" + name
        if solum.is_directory(path) ↦ bool {
            const list<string> sub ← collect_fab(path)
            const int sn ← sub.length()
            var int j ← 0
            while j ≺ sn {
                out.append(sub[j])
                j ← j + 1
            }
        } else {
            if name.ends_with(".fab") {
                out.append(path)
            }
        }
        i ← i + 1
    }
    return out
}

# Scan a source text for `call 'route'` occurrences, mirroring the regex
# `\bcall\s+'([^']+)'`: `call` not preceded by a word character, then
# whitespace, then a single-quoted route (the route requires at least one
# character). Scanned per line (splitting on "\n"): every `call 'route'`
# occurrence in the corpus sits on one line, so this is behavior-identical
# to the whole-text regex while avoiding per-character slicing of the whole
# file.
fn call_routes(string text) → list<string> {
    const string word_chars ← "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    var list<string> routes ← empty
    const list<string> lines ← text.split("\n")
    const int line_count ← lines.length()
    var int li ← 0
    while li ≺ line_count {
        const string line ← lines[li]
        if line.contains("call") {
            const int n ← line.length()
            var int i ← 0
            while i ≺ n {
                if line.slice(i, i + 4) ≡ "call" {
                    var bool boundary ← true
                    if i ≻ 0 {
                        if word_chars.contains(line.slice(i - 1, i)) {
                            boundary ← false
                        }
                    }
                    if boundary {
                        # skip Python \s within the line
                        var int j ← i + 4
                        var bool scanning ← true
                        while j ≺ n and scanning {
                            const string c ← line.slice(j, j + 1)
                            if c ≡ " " or c ≡ "\t" {
                                j ← j + 1
                            } else {
                                scanning ← false
                            }
                        }
                        if j ≺ n {
                            if line.slice(j, j + 1) ≡ "'" {
                                var int k ← j + 1
                                var bool closed ← false
                                var string route ← ""
                                while k ≺ n and closed ≡ false {
                                    const string c2 ← line.slice(k, k + 1)
                                    if c2 ≡ "'" {
                                        closed ← true
                                    } else {
                                        route ← route + c2
                                        k ← k + 1
                                    }
                                }
                                if closed and route.length() ≻ 0 {
                                    routes.append(route)
                                }
                            }
                        }
                    }
                }
                i ← i + 1
            }
        }
        li ← li + 1
    }
    return routes
}

fn source_routes(string src) → list<string> ⇥ string {
    var list<string> all ← empty
    const list<string> files ← collect_fab(src)
    const int n ← files.length()
    var int i ← 0
    while i ≺ n {
        const string text ← solum.read_file(files[i]) ↦ string
        const list<string> found ← call_routes(text)
        const int fc ← found.length()
        var int j ← 0
        while j ≺ fc {
            if contains_route(all, found[j]) ≡ false {
                all.append(found[j])
            }
            j ← j + 1
        }
        i ← i + 1
    }
    return all
}

# Routes whose family prefix matches, mirroring the Python partition-by-`:`
# filter into the per-family sets.
fn routes_with_prefix(list<string> all, string family) → list<string> {
    const string prefix ← family + ":"
    var list<string> out ← empty
    const int n ← all.length()
    var int i ← 0
    while i ≺ n {
        if all[i].starts_with(prefix) {
            out.append(all[i])
        }
        i ← i + 1
    }
    return out
}

# ===========================================================================
# PROVIDER EVIDENCE (faberlang/hosts sibling checkout)
# ===========================================================================

fn manifest_routes(string host, string family) → list<string> ⇥ string {
    const string manifest ← host + "/crates/" + family + "/src/manifest.json"
    if solum.is_regular(manifest) ↦ bool ≡ false {
        consolum.warn_line("audit-provider-route-claims: missing provider manifest: " + manifest)
        processus.exit_process(1)
    }
    const string wire ← solum.read_file(manifest) ↦ string
    const map<string, value> payload ← json.parse(wire) ↦ map<string, value>
    const list<value> calls ← payload["calls"] ↦ list<value>
    var list<string> routes ← empty
    const int n ← calls.length()
    var int i ← 0
    while i ≺ n {
        const map<string, value> entry ← calls[i] ↦ map<string, value>
        const string route ← entry["route"] ↦ string
        routes.append(route)
        i ← i + 1
    }
    return routes
}

# Brace-matched body of the `match request.route.as_str() { ... }` dispatch,
# then every `"family:route"` string inside it (same findings as the Python
# body-extract + regex pass).
fn dispatch_corpus(string host, string family) → list<string> ⇥ string {
    const string lib ← host + "/crates/" + family + "/src/lib.rs"
    if solum.is_regular(lib) ↦ bool ≡ false {
        consolum.warn_line("audit-provider-route-claims: missing provider dispatch source: " + lib)
        processus.exit_process(1)
    }
    const string source ← solum.read_file(lib) ↦ string
    const string marker ← "match request.route.as_str()"
    const int marker_len ← marker.length()
    const int src_len ← source.length()
    var int pos ← 0
    var bool marker_found ← false
    while pos ≺ src_len and marker_found ≡ false {
        if source.slice(pos, pos + marker_len) ≡ marker {
            marker_found ← true
        } else {
            pos ← pos + 1
        }
    }
    if marker_found ≡ false {
        consolum.warn_line("audit-provider-route-claims: missing dispatch match on request.route.as_str() for " + family)
        processus.exit_process(1)
    }
    var int open_brace ← pos + marker_len
    var bool brace_found ← false
    while open_brace ≺ src_len and brace_found ≡ false {
        if source.slice(open_brace, open_brace + 1) ≡ "{" {
            brace_found ← true
        } else {
            open_brace ← open_brace + 1
        }
    }
    if brace_found ≡ false {
        consolum.warn_line("audit-provider-route-claims: missing dispatch match body for " + family)
        processus.exit_process(1)
    }
    # depth scan from inside the opening brace; collect `"family:route"` strings
    var list<string> routes ← empty
    const string route_prefix ← "\"" + family + ":"
    const int route_prefix_len ← route_prefix.length()
    var int depth ← 1
    var int index ← open_brace + 1
    while index ≺ src_len and depth ≻ 0 {
        const string ch ← source.slice(index, index + 1)
        if ch ≡ "{" {
            depth ← depth + 1
            index ← index + 1
        } else {
            if ch ≡ "}" {
                depth ← depth - 1
                index ← index + 1
            } else {
                if ch ≡ "\"" {
                    if source.slice(index, index + route_prefix_len) ≡ route_prefix {
                        var int k ← index + route_prefix_len
                        var string route ← route_prefix.slice(1, route_prefix_len)
                        var bool route_closed ← false
                        while k ≺ src_len and route_closed ≡ false {
                            const string c2 ← source.slice(k, k + 1)
                            if c2 ≡ "\"" {
                                route_closed ← true
                            } else {
                                route ← route + c2
                                k ← k + 1
                            }
                        }
                        if route_closed {
                            routes.append(route)
                            index ← k
                        } else {
                            index ← index + 1
                        }
                    } else {
                        index ← index + 1
                    }
                } else {
                    index ← index + 1
                }
            }
        }
    }
    return routes
}

fn git_short_head(string host) → string ⇥ string {
    const map<string, value> result ← processus.captura(["git", "-C", host, "rev-parse", "--short=7", "HEAD"]) ↦ map<string, value>
    const int status ← result["status"] ↦ int
    if status ≠ 0 {
        const string err ← result["stderr"] ↦ string
        consolum.warn_line("audit-provider-route-claims: could not read git HEAD for provider evidence repo " + host + ": " + err.trim())
        processus.exit_process(1)
    }
    const string stdout ← result["stdout"] ↦ string
    return stdout.trim()
}

fn dirty_provider_paths(string host) → list<string> ⇥ string {
    const map<string, value> refresh ← processus.captura(["git", "-C", host, "update-index", "-q", "--refresh"]) ↦ map<string, value>
    const int refresh_status ← refresh["status"] ↦ int
    if refresh_status ≠ 0 {
        const string err ← refresh["stderr"] ↦ string
        consolum.warn_line("audit-provider-route-claims: could not refresh provider evidence git index for " + host + ": " + err.trim())
        processus.exit_process(1)
    }
    const map<string, value> result ← processus.captura(["git", "-C", host, "status", "--porcelain=v1", "--untracked-files=all"]) ↦ map<string, value>
    const int status ← result["status"] ↦ int
    if status ≠ 0 {
        const string err ← result["stderr"] ↦ string
        consolum.warn_line("audit-provider-route-claims: could not inspect provider evidence git status for " + host + ": " + err.trim())
        processus.exit_process(1)
    }
    const string raw ← result["stdout"] ↦ string
    const list<string> lines ← raw.split("\n")
    var list<string> dirty ← empty
    const int n ← lines.length()
    var int i ← 0
    while i ≺ n {
        const string line ← lines[i]
        if line.length() ≻ 0 {
            dirty.append(line)
        }
        i ← i + 1
    }
    return dirty
}

# Last path segment of the evidence repo (used in diagnostics).
fn repo_name(string host) → string {
    const list<string> parts ← host.split("/")
    const int n ← parts.length()
    var string last ← host
    var int i ← 0
    while i ≺ n {
        if parts[i].length() ≻ 0 {
            last ← parts[i]
        }
        i ← i + 1
    }
    return last
}

# ===========================================================================
# AUDIT
# ===========================================================================

fn check_clean_provider_checkout(string host, mut list<string> stderr_lines) → bool ⇥ string {
    const list<string> dirty ← dirty_provider_paths(host)
    if dirty.length() ≡ 0 {
        return true
    }
    const string name ← repo_name(host)
    stderr_lines.append("audit-provider-route-claims: " + name + " evidence checkout is dirty; commit or clean provider manifest/dispatch changes before accepting pinned evidence")
    const int n ← dirty.length()
    var int i ← 0
    while i ≺ n {
        stderr_lines.append("  " + dirty[i])
        i ← i + 1
    }
    return false
}

fn run_audit(string root, string host, string expected_rev, mut list<string> stdout_lines, mut list<string> stderr_lines) → int ⇥ string {
    const string actual_rev ← git_short_head(host)
    const bool revision_ok ← actual_rev ≡ expected_rev
    if revision_ok ≡ false {
        const string name ← repo_name(host)
        stderr_lines.append("audit-provider-route-claims: " + name + " revision mismatch: expected " + expected_rev + ", got " + actual_rev)
    }
    const bool clean_ok ← check_clean_provider_checkout(host, mut stderr_lines)
    var int status ← 0
    if revision_ok ≡ false or clean_ok ≡ false {
        status ← 1
    }
    const string name ← repo_name(host)
    stdout_lines.append(name + ": rev=" + actual_rev)

    const list<string> all_routes ← source_routes(root + "/src")
    const list<string> families ← ["aleator", "consolum", "processus", "solum", "tempus"]
    const int nf ← families.length()
    var int fi ← 0
    while fi ≺ nf {
        const string family ← families[fi]
        const list<string> claimed ← routes_with_prefix(all_routes, family)
        const list<string> manifested ← manifest_routes(host, family)
        const list<string> dispatched ← dispatch_corpus(host, family)

        # source-only exclusions (processus:exi is the only one)
        var list<string> exclusions ← empty
        if family ≡ "processus" {
            exclusions.append("processus:exi")
        }

        # manifest-only exceptions: provider routes deliberately manifested
        # and dispatched without a Norma source claim. solum:digestio is the
        # streamed SHA-256 file digest (hosts 5a52ee52) admitted for direct
        # host use — the file-streaming admission seam (Vivi 8a08bd23),
        # distinct from norma:crypta.digest — so Norma keeps no claim and no
        # wrapper. Only the source-claim requirement is waived; a route that
        # leaves the manifest makes the exception stale.
        var list<string> manifest_only ← empty
        if family ≡ "solum" {
            manifest_only.append("solum:digestio")
        }

        const list<string> claimed_manifested ← difference(claimed, manifested)
        const list<string> unexpected_source_only ← difference(claimed_manifested, exclusions)
        const list<string> stale_exceptions ← difference(manifest_only, manifested)
        const list<string> exception_used ← difference(manifest_only, stale_exceptions)
        const list<string> missing_from_source ← difference(difference(manifested, claimed), exception_used)
        const list<string> missing_from_dispatch ← difference(manifested, dispatched)
        const list<string> stale_exclusions ← difference(exclusions, claimed_manifested)
        const list<string> excluded_used ← difference(exclusions, stale_exclusions)
        const list<string> dispatch_common ← intersect(dispatched, manifested)

        # summary line (stdout)
        var string summary ← family + ": source=" + (claimed.length() ↦ string)
        summary ← summary + " manifest=" + (manifested.length() ↦ string)
        summary ← summary + " dispatch=" + (dispatch_common.length() ↦ string)
        summary ← summary + " excluded=" + (excluded_used.length() ↦ string)
        summary ← summary + " exception=" + (exception_used.length() ↦ string)
        stdout_lines.append(summary)

        # excluded source-only routes (stdout, sorted)
        const list<string> excluded_list ← intersect(exclusions, claimed_manifested)
        const list<string> excluded_sorted ← excluded_list.sorted() ↦ list<string>
        const int el ← excluded_sorted.length()
        var int ei ← 0
        while ei ≺ el {
            stdout_lines.append("  excluded source-only: " + excluded_sorted[ei] + " (process exit is source-only until host exit has a protocol-visible terminal response)")
            ei ← ei + 1
        }

        # manifest-only exceptions in force (stdout, sorted)
        const list<string> exception_sorted ← exception_used.sorted() ↦ list<string>
        const int xl ← exception_sorted.length()
        var int xi ← 0
        while xi ≺ xl {
            stdout_lines.append("  manifest-only exception: " + exception_sorted[xi] + " (deliberately direct-host: streamed SHA-256 file digest admitted with no Norma claim or wrapper)")
            xi ← xi + 1
        }

        if unexpected_source_only.length() ≻ 0 {
            status ← 1
            stderr_lines.append("audit-provider-route-claims: " + family + " source routes missing from manifest:")
            const list<string> sorted ← unexpected_source_only.sorted() ↦ list<string>
            const int sn ← sorted.length()
            var int li ← 0
            while li ≺ sn {
                stderr_lines.append("  " + sorted[li])
                li ← li + 1
            }
        }
        if missing_from_source.length() ≻ 0 {
            status ← 1
            stderr_lines.append("audit-provider-route-claims: " + family + " manifest routes missing from Norma source:")
            const list<string> sorted ← missing_from_source.sorted() ↦ list<string>
            const int sn ← sorted.length()
            var int li ← 0
            while li ≺ sn {
                stderr_lines.append("  " + sorted[li])
                li ← li + 1
            }
        }
        if missing_from_dispatch.length() ≻ 0 {
            status ← 1
            stderr_lines.append("audit-provider-route-claims: " + family + " manifest routes missing from provider dispatch:")
            const list<string> sorted ← missing_from_dispatch.sorted() ↦ list<string>
            const int sn ← sorted.length()
            var int li ← 0
            while li ≺ sn {
                stderr_lines.append("  " + sorted[li])
                li ← li + 1
            }
        }
        if stale_exclusions.length() ≻ 0 {
            status ← 1
            stderr_lines.append("audit-provider-route-claims: stale source-only exclusions for " + family + ":")
            const list<string> sorted ← stale_exclusions.sorted() ↦ list<string>
            const int sn ← sorted.length()
            var int li ← 0
            while li ≺ sn {
                stderr_lines.append("  " + sorted[li])
                li ← li + 1
            }
        }
        if stale_exceptions.length() ≻ 0 {
            status ← 1
            stderr_lines.append("audit-provider-route-claims: stale manifest-only exceptions for " + family + ":")
            const list<string> sorted ← stale_exceptions.sorted() ↦ list<string>
            const int sn ← sorted.length()
            var int li ← 0
            while li ≺ sn {
                stderr_lines.append("  " + sorted[li])
                li ← li + 1
            }
        }
        fi ← fi + 1
    }
    return status
}

# ===========================================================================
# SELF-TEST (negative fixtures: missing dispatch, dirty evidence, rev
# mismatch, unclaimed manifested route, stale manifest-only exception; the
# manifest-only exception is asserted reported on stdout)
# ===========================================================================

fn self_test_run() → int ⇥ string {
    const int pid ← processus.pid() ↦ int
    const string pid_s ← pid ↦ string
    const string tmp_base ← solum.temp_dir() ↦ string
    const string base ← tmp_base + "/norma-route-audit-" + pid_s
    const string norma_root ← base + "/norma"
    const string host ← base + "/host-providers-rs"
    solum.create_dir(norma_root + "/src")

    const list<string> families ← ["aleator", "consolum", "processus", "solum", "tempus"]
    const int nf ← families.length()
    var int fi ← 0
    while fi ≺ nf {
        const string family ← families[fi]
        const string provider_src ← host + "/crates/" + family + "/src"
        solum.create_dir(provider_src)
        # manifest routes: one per family; aleator adds `missing`; processus adds `exi`;
        # solum adds `digestio` (manifested + dispatched, never claimed — the
        # manifest-only exception under test)
        var list<string> routes ← ["one"]
        if family ≡ "aleator" {
            routes.append("missing")
        }
        if family ≡ "processus" {
            routes.append("exi")
        }
        if family ≡ "solum" {
            routes.append("digestio")
        }
        var string calls_json ← ""
        const int rn ← routes.length()
        var int ri ← 0
        while ri ≺ rn {
            if ri ≻ 0 {
                calls_json ← calls_json + ", "
            }
            calls_json ← calls_json + "{\"route\": \"" + family + ":" + routes[ri] + "\"}"
            ri ← ri + 1
        }
        const string manifest_text ← "{\"manifest_version\": 1, \"provider\": \"" + family + "\", \"prefix\": \"" + family + "\", \"calls\": [" + calls_json + "]}"
        solum.write_file(provider_src + "/manifest.json", manifest_text)
        # dispatch: only `family:one` is matched (aleator:missing is undispatchable);
        # solum also dispatches `digestio` so the manifest-only exception keeps
        # its manifest-to-dispatch checking
        var string arms ← "        \"" + family + ":one\" => Ok(())"
        if family ≡ "solum" {
            arms ← arms + ",\n        \"" + family + ":digestio\" => Ok(())"
        }
        const string lib_text ← "fn dispatch(request: RequestFrame) {\n    match request.route.as_str() {\n" + arms + ",\n        other => Err(other),\n    }\n}\n"
        solum.write_file(provider_src + "/lib.rs", lib_text)
        fi ← fi + 1
    }
    # source routes.fab claiming every route (so aleator:missing shows up)
    var string routes_fab ← ""
    const int nf2 ← families.length()
    var int f2 ← 0
    while f2 ≺ nf2 {
        const string family ← families[f2]
        var list<string> routes ← ["one"]
        if family ≡ "aleator" {
            routes.append("missing")
        }
        if family ≡ "processus" {
            routes.append("exi")
        }
        const int rn ← routes.length()
        var int ri ← 0
        while ri ≺ rn {
            const string route ← family + ":" + routes[ri]
            const string safe ← route.replace(":", "_")
            routes_fab ← routes_fab + "fn " + safe + "() = call '" + route + "' ()\n"
            ri ← ri + 1
        }
        f2 ← f2 + 1
    }
    solum.write_file(norma_root + "/src/routes.fab", routes_fab)

    const map<string, value> init_result ← processus.captura(["git", "-C", host, "init", "-q"]) ↦ map<string, value>
    const int init_status ← init_result["status"] ↦ int
    if init_status ≠ 0 {
        consolum.warn_line("audit-provider-route-claims: self-test git init failed")
        return 1
    }
    const map<string, value> add_result ← processus.captura(["git", "-C", host, "add", "."]) ↦ map<string, value>
    const int add_status ← add_result["status"] ↦ int
    if add_status ≠ 0 {
        consolum.warn_line("audit-provider-route-claims: self-test git add failed")
        return 1
    }
    const map<string, value> commit_result ← processus.captura(["git", "-C", host, "-c", "user.name=Norma Route Audit", "-c", "user.email=norma-route-audit@example.invalid", "commit", "-q", "-m", "self-test provider evidence"]) ↦ map<string, value>
    const int commit_status ← commit_result["status"] ↦ int
    if commit_status ≠ 0 {
        const string commit_err ← commit_result["stderr"] ↦ string
        consolum.warn_line("audit-provider-route-claims: self-test git commit failed: " + commit_err.trim())
        return 1
    }

    const string actual_rev ← git_short_head(host)

    # Fixture 1: missing dispatch route must be rejected (aleator:missing)
    var list<string> stdout_lines ← empty
    var list<string> stderr_lines ← empty
    const int status_one ← run_audit(norma_root, host, actual_rev, mut stdout_lines, mut stderr_lines)
    if status_one ≡ 0 {
        consolum.warn_line("audit-provider-route-claims: self-test failed to reject a missing dispatch route")
        solum.remove_tree(base)
        return 1
    }
    if lines_contain(stderr_lines, "aleator:missing") ≡ false {
        consolum.warn_line("audit-provider-route-claims: self-test did not report the expected route")
        solum.remove_tree(base)
        return 1
    }
    if lines_contain(stdout_lines, "manifest-only exception: solum:digestio") ≡ false {
        consolum.warn_line("audit-provider-route-claims: self-test did not report the manifest-only exception")
        solum.remove_tree(base)
        return 1
    }

    # Fixture 2: dirty provider evidence must be rejected
    # (rebuild the aleator manifest with an extra route, making the checkout dirty)
    const string aleator_src ← host + "/crates/aleator/src"
    const string dirty_manifest ← "{\"manifest_version\": 1, \"provider\": \"aleator\", \"prefix\": \"aleator\", \"calls\": [{\"route\": \"aleator:one\"}, {\"route\": \"aleator:missing\"}, {\"route\": \"aleator:dirty\"}]}"
    solum.write_file(aleator_src + "/manifest.json", dirty_manifest)
    var list<string> stdout_two ← empty
    var list<string> stderr_two ← empty
    const int status_two ← run_audit(norma_root, host, actual_rev, mut stdout_two, mut stderr_two)
    if status_two ≡ 0 {
        consolum.warn_line("audit-provider-route-claims: self-test failed to reject dirty provider evidence")
        solum.remove_tree(base)
        return 1
    }
    if lines_contain(stderr_two, "checkout is dirty") ≡ false {
        consolum.warn_line("audit-provider-route-claims: self-test did not report dirty provider evidence")
        solum.remove_tree(base)
        return 1
    }

    # Fixture 3: revision mismatch must be rejected (restore clean evidence first)
    const string clean_manifest ← "{\"manifest_version\": 1, \"provider\": \"aleator\", \"prefix\": \"aleator\", \"calls\": [{\"route\": \"aleator:one\"}, {\"route\": \"aleator:missing\"}]}"
    solum.write_file(aleator_src + "/manifest.json", clean_manifest)
    var list<string> stdout_three ← empty
    var list<string> stderr_three ← empty
    const int status_three ← run_audit(norma_root, host, "0000000", mut stdout_three, mut stderr_three)
    if status_three ≡ 0 {
        consolum.warn_line("audit-provider-route-claims: self-test failed to reject a revision mismatch")
        solum.remove_tree(base)
        return 1
    }
    if lines_contain(stderr_three, "revision mismatch") ≡ false {
        consolum.warn_line("audit-provider-route-claims: self-test did not report the expected revision mismatch")
        solum.remove_tree(base)
        return 1
    }

    # Fixture 4: a different manifested-and-dispatched route with no Norma
    # claim stays subject to the source-claim requirement (no exception creep)
    const string unclaimed_manifest ← "{\"manifest_version\": 1, \"provider\": \"aleator\", \"prefix\": \"aleator\", \"calls\": [{\"route\": \"aleator:one\"}, {\"route\": \"aleator:missing\"}, {\"route\": \"aleator:unclaimed\"}]}"
    solum.write_file(aleator_src + "/manifest.json", unclaimed_manifest)
    const string unclaimed_lib ← "fn dispatch(request: RequestFrame) {\n    match request.route.as_str() {\n        \"aleator:one\" => Ok(()),\n        \"aleator:missing\" => Ok(()),\n        \"aleator:unclaimed\" => Ok(()),\n        other => Err(other),\n    }\n}\n"
    solum.write_file(aleator_src + "/lib.rs", unclaimed_lib)
    var list<string> stdout_four ← empty
    var list<string> stderr_four ← empty
    const int status_four ← run_audit(norma_root, host, actual_rev, mut stdout_four, mut stderr_four)
    if status_four ≡ 0 {
        consolum.warn_line("audit-provider-route-claims: self-test failed to reject a manifested route with no Norma claim")
        solum.remove_tree(base)
        return 1
    }
    if lines_contain(stderr_four, "aleator:unclaimed") ≡ false {
        consolum.warn_line("audit-provider-route-claims: self-test did not report the unclaimed manifested route")
        solum.remove_tree(base)
        return 1
    }

    # Fixture 5: a stale manifest-only exception must fail closed (route
    # absent from the provider manifest)
    const string solum_src ← host + "/crates/solum/src"
    const string no_digestio_manifest ← "{\"manifest_version\": 1, \"provider\": \"solum\", \"prefix\": \"solum\", \"calls\": [{\"route\": \"solum:one\"}]}"
    solum.write_file(solum_src + "/manifest.json", no_digestio_manifest)
    var list<string> stdout_five ← empty
    var list<string> stderr_five ← empty
    const int status_five ← run_audit(norma_root, host, actual_rev, mut stdout_five, mut stderr_five)
    if status_five ≡ 0 {
        consolum.warn_line("audit-provider-route-claims: self-test failed to reject a stale manifest-only exception")
        solum.remove_tree(base)
        return 1
    }
    if lines_contain(stderr_five, "stale manifest-only exceptions") ≡ false {
        consolum.warn_line("audit-provider-route-claims: self-test did not report the stale-exception finding")
        solum.remove_tree(base)
        return 1
    }
    if lines_contain(stderr_five, "solum:digestio") ≡ false {
        consolum.warn_line("audit-provider-route-claims: self-test did not name the stale exception route")
        solum.remove_tree(base)
        return 1
    }

    solum.remove_tree(base)
    consolum.write_line("audit-provider-route-claims: self-test passed")
    return 0
}

# ===========================================================================
# ENTRY
# ===========================================================================

main {
    const string root ← processus.cwd() ↦ string
    var string host ← root + "/../hosts"
    var string expected_rev ← ""
    var bool self_test ← false
    const list<string> argv ← processus.argv() ↦ list<string>
    const int argc ← argv.length()
    var int ai ← 0
    while ai ≺ argc {
        const string arg ← argv[ai]
        if arg ≡ "--self-test" {
            self_test ← true
        } else {
            if arg ≡ "--host-providers" {
                ai ← ai + 1
                if ai ≺ argc {
                    host ← argv[ai]
                }
            } else {
                if arg ≡ "--expected-rev" {
                    ai ← ai + 1
                    if ai ≺ argc {
                        expected_rev ← argv[ai]
                    }
                }
            }
        }
        ai ← ai + 1
    }

    if self_test {
        const int st ← self_test_run()
        processus.exit_process(st)
    }

    # Default subject: the live provider evidence. Resolve the hosts HEAD at
    # audit time so the audit assesses current hosts and records the examined
    # revision; --expected-rev overrides with an explicit historical pin.
    if expected_rev.length() ≡ 0 {
        expected_rev ← git_short_head(host)
    }

    var list<string> stdout_lines ← empty
    var list<string> stderr_lines ← empty
    const int status ← run_audit(root, host, expected_rev, mut stdout_lines, mut stderr_lines)

    const int so ← stdout_lines.length()
    var int oi ← 0
    while oi ≺ so {
        consolum.write_line(stdout_lines[oi])
        oi ← oi + 1
    }
    const int se ← stderr_lines.length()
    var int ei ← 0
    while ei ≺ se {
        consolum.warn_line(stderr_lines[ei])
        ei ← ei + 1
    }
    processus.exit_process(status)
}
