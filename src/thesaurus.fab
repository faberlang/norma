+++
locale = "en"
+++

# thesaurus.fab - Cache and Pub/Sub Device
#
# Etymology: "thesaurus" - treasury, storehouse. A cache of values.
#
# Part of the host effect surface (gateway-dispatched `thesaurus:*` routes).
#
# Design notes:
# - Verb conjugation encodes sync/async:
# - Future (-et, -abit, -ent): async operations
# - Imperative: sync operations
# - Key-value cache with TTL
# - Pub/sub messaging with pattern subscriptions
# - In-memory for dev/single-node, Redis for production

# =========================================================================
# KEY-VALUE CACHE
# =========================================================================

# Get value by key (returns nihil if not found)
@ future
fn capiet(string clavis) → string ∪ null {
    panic "norma:thesaurus.capiet is deferred pending Stage 2 dispatch"
}

# Set value with optional TTL in seconds
@ future
fn ponet(string clavis, string value, int ttl) → void {
    panic "norma:thesaurus.ponet is deferred pending Stage 2 dispatch"
}

# Set value only if key doesn't exist
@ future
fn condet(string clavis, string value) → bool {
    panic "norma:thesaurus.condet is deferred pending Stage 2 dispatch"
}

# Delete key(s)
@ future
fn delet(list<string> claves) → int {
    panic "norma:thesaurus.delet is deferred pending Stage 2 dispatch"
}

# Check if key exists
@ future
fn exstabit(string clavis) → bool {
    panic "norma:thesaurus.exstabit is deferred pending Stage 2 dispatch"
}

# Get remaining TTL in seconds (-1 = no expiry, -2 = not found)
@ future
fn ttl(string clavis) → int {
    panic "norma:thesaurus.ttl is deferred pending Stage 2 dispatch"
}

# Set expiry on existing key
@ future
fn expirabit(string clavis, int secundae) → bool {
    panic "norma:thesaurus.expirabit is deferred pending Stage 2 dispatch"
}

# =========================================================================
# NUMERIC OPERATIONS
# =========================================================================

# Increment by amount (default 1)
@ future
fn augebit(string clavis, int quantum) → int {
    panic "norma:thesaurus.augebit is deferred pending Stage 2 dispatch"
}

# Decrement by 1
@ future
fn minuet(string clavis) → int {
    panic "norma:thesaurus.minuet is deferred pending Stage 2 dispatch"
}

# =========================================================================
# KEY QUERIES
# =========================================================================

# Find keys matching glob pattern
@ future
fn quaeret(string exemplar) → list<string> {
    panic "norma:thesaurus.quaeret is deferred pending Stage 2 dispatch"
}

# =========================================================================
# PUB/SUB
# =========================================================================

# Publish message to topic, returns subscriber count
@ future
fn publicabit(string thema, string nuntius) → int {
    panic "norma:thesaurus.publicabit is deferred pending Stage 2 dispatch"
}

# Subscribe to topic patterns
# Pattern: * matches one segment, ** matches multiple
@ future
fn auscultabit(list<string> exemplaria) → Subscriptio {
    panic "norma:thesaurus.auscultabit is deferred pending Stage 2 dispatch"
}

# Pub/Sub subscription
interface Subscriptio {
    # Iterate over incoming messages (async generator)
    @ future
    @ cursor
    fn nuntiabunt() → cursor<Nuntius>

    # Unsubscribe and cleanup
    fn claude() → void
}

# Pub/Sub message
interface Nuntius {
    fn thema() → string

    fn corpus() → string

    fn tempus() → int
}
