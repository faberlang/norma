# Colocated stdlib test source for math (public catalog).
# Not importable; discovered only by the faber test path (`include_proba`).
import from "./math" math

fn sum_pi(float x) → float {
    return math.add(math.PI(), x)
}

describe "math catalog" {
    test "PI is positive" {
        assert math.PI() > 0.0
    }

    test "add composes with PI helper" {
        assert sum_pi(0.0) ≡ math.PI()
    }

    test "add is commutative on unit" {
        assert math.add(1.0, 2.0) ≡ math.add(2.0, 1.0)
    }
}
