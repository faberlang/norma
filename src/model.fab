+++
locale = "en"
+++

# model.fab — model metadata classification facade
#
# Public import: importa ex "norma:model" privata model
#
# C3 no-dual-authority (PML2-U5): the model-format admission surface this
# module hosted in Stage 1 — container byte parsing, tensor metadata, and
# summary construction — migrated into gradus (gradus/src/model/, single
# owning path per pml0-admission-migration-decision.md). The
# summary/record role is absorbed by the gradus capsule and its diagnostic
# types per pml0-norma-model-decision.md; this module is now a pure
# classification/diagnostic helper floor only. It imports nothing and does
# no byte parsing.

class Diagnosticum {
    string severitas
    string nuntius
}

fn formatum(string status, string source) → string {
    if status ≡ "missing-download" then return "alias-missing"
    if source.contains("GGUF") then return "gguf"
    if source.ends_with(".gguf") then return "gguf"
    if source.contains("safetensors") then return "safetensors"
    if source.ends_with(".safetensors") then return "safetensors"
    return "unknown"
}

fn diagnosticum(string status, string source, string router_model_id) → string {
    if status ≡ "router-backed" then return "metadata parser pending; router model is " + router_model_id
    if status ≡ "missing-download" then return "missing local download for " + source
    if status ≡ "unsupported" then return "unsupported model format for " + source
    if status ≡ "error" then return "model metadata error for " + source
    return "unknown alias or unsupported path"
}

fn severitas_pro_status(string status) → string {
    if status ≡ "error" then return "error"
    return "warning"
}

fn inanis_diagnosticum(string status, string source, string router_model_id) → list<Diagnosticum> {
    return [
        Diagnosticum {
            severitas = severitas_pro_status(status),
            nuntius = diagnosticum(status, source, router_model_id)
        }
    ]
}

describe "model metadata facade" {
    test "classifies campaign alias formats" {
        assert formatum("missing-download", "sentence-transformers/all-MiniLM-L6-v2") ≡ "alias-missing"
        assert formatum("router-backed", "unsloth/Qwen3.6-35B-A3B-GGUF") ≡ "gguf"
        assert formatum("local", "/tmp/model.safetensors") ≡ "safetensors"
    }

    test "builds structured diagnostic records" {
        const list<Diagnosticum> diagnostics ← inanis_diagnosticum(
            "error",
            "/tmp/not-a-model.bin",
            ""
        )
        assert diagnostics.length() ≡ 1
        assert severitas_pro_status("error") ≡ "error"
    }
}
