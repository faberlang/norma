 8c bd f8 3e e1 bb e3 e8 08 3d 82 35 c9 3d 18 ea 46 3d 34 c6 2d 3d 1d fb 2c 3a e2 57 e5 bc bd 78 94 3d cb 2d 87 bc 9d d4 5f 3c 97 5f df 3d 44 d8 ca bc 0e fb a7 bb a6 3a 67 3d 7b 38 62 3b 0d c0 78 bd 1d 5d e8 3c 96 65 7e bd 42 cc 97 3a 22 9c 84 3c a3 78 2c 3d bc 75 c0 bd c9 71 e9 bc e2 c2 25 be cb 0f 8b 3c f1 5b f9 bc c0 58 3d bc 96 d2 af ba 55 85 70 bd 12 29 02 bc d1 8d fc 3c c7 d6 d4 ba 10 8e 91 3d b0 6b 0a bd 94 c2 c8 3c 1f fe ad 3c 93 b1 b9 bc fe e0 e2 3d 5b b4 87 bc f6 5c af 3c 39 f5 9a 3d 4e 22 0e 3a 61 63 67 be 00 98 2c 3a 1d d7 c0 bd 3e 93 9e 3c 1d 4e 87 bd 31 3f fa bc 74 70 2f bb 58 d1 5d 3d 09 e3 84 3d 23 bf 57 3d f5 50 ef 3d c8 e4 c6 3c 90 81 60 3d 05 ac 3d be 35 6e 5e 3e a0 ff bc 3d 1b 0b c6 3c dd 69 05 3d 6f e0 4d 3d 09 36 91 bc c0 d2 93 bd 67 30 55 bd f1 da e6 3b 34 d5 aa 3c 67 c0 35 bc cc cd 4b 3d 47 a6 da 3c fb 91 2f 3c a4 f8 88 3d d1 15 3b 3d 68 aa 24 3c b8 0d 87 3c 9a 7d c1 3d 8e 68 b2 bc 46 83 4c bd eb 65 81 3d 54 ba d8 3d 7a 91 9d bd 4a 6c 62 bd|
        fixum ModelSummary summary ← tempta_safetensors_summarium("bert-tiny", "DeepWokLab/bert-tiny", "model.safetensors", data)
        adfirma summary.formatum ≡ "safetensors"
        fixum lista<MetadataTensor> tensors ← summary.tensors
        adfirma tensors.longitudo() ≡ 1
        fixum MetadataTensor info ← tensors[0]
        adfirma info.nomen ≡ "encoder.layer.0.attention.self.query.weight"
        adfirma info.figura ≡ [128, 128]
        adfirma info.dtype ≡ "F32"
        adfirma info.parameter_count ≡ 16384
        fac {
            fixum lista<f32> flat ← safetensors_tensor_f32(data, info)
            adfirma flat.longitudo() ≡ 16384
            fixum f32 first ← flat[0]
            adfirma (first ↦ fractus) ≠ 0.0
            fixum f32 last ← flat[16383]
            adfirma (last ↦ fractus) ≠ 0.0
        }
        cape err {
            adfirma falsum
        }
    }





    proba "decodes safetensors edge values: 0.0, -1.0, 0.5, 1e30, inf" {
        # shape [5] tensor with values [0.0, -1.0, 0.5, 1e30, +inf]
        fixum octeti data ← |3a 00 00 00 00 00 00 00 7b 22 74 65 73 74 22 3a 7b 22 64 74 79 70 65 22 3a 22 46 33 32 22 2c 22 73 68 61 70 65 22 3a 5b 35 5d 2c 22 64 61 74 61 5f 6f 66 66 73 65 74 73 22 3a 5b 30 2c 32 30 5d 7d 7d 00 00 00 00 00 00 80 bf 00 00 00 3f ca f2 49 71 00 00 80 7f|
        fac {
            fixum ModelSummary summary ← safetensors_summarium("fixture", "fixture", "fixture.safetensors", data)
            fixum MetadataTensor info ← summary.tensors[0]
            fixum lista<f32> result ← safetensors_tensor_f32(data, info)
            adfirma result.longitudo() ≡ 5
            adfirma (result[0] ↦ fractus) ≡ 0.0
            adfirma (result[1] ↦ fractus) ≡ (-1.0)
            adfirma (result[2] ↦ fractus) ≡ 0.5
            adfirma (result[3] ↦ fractus) > 1e29
            adfirma (result[3] ↦ fractus) < 1e31
            adfirma (result[4] ↦ fractus) > 1e30
        }
        cape err {
            adfirma falsum
        }
    }

    proba "rejects safetensors NaN payload" {
        # shape [1] tensor with quiet NaN bit pattern 0x7fc00000
        fixum octeti data ← |39 00 00 00 00 00 00 00 7b 22 74 65 73 74 22 3a 7b 22 64 74 79 70 65 22 3a 22 46 33 32 22 2c 22 73 68 61 70 65 22 3a 5b 31 5d 2c 22 64 61 74 61 5f 6f 66 66 73 65 74 73 22 3a 5b 30 2c 34 5d 7d 7d 00 00 c0 7f|
        fac {
            fixum ModelSummary summary ← safetensors_summarium("fixture", "fixture", "fixture.safetensors", data)
            fixum MetadataTensor info ← summary.tensors[0]
            fixum lista<f32> _ ← safetensors_tensor_f32(data, info)
            adfirma falsum
        }
        cape err {
            adfirma err.continet("NaN")
        }
    }

}
