        fac {
            fixum ModelSummary summary ← safetensors_summarium("fixture", "fixture", "fixture.safetensors", data)
            fixum MetadataTensor info ← summary.tensors[0]
            fixum lista<f32> _ ← safetensors_tensor_f32(data, info)
            adfirma falsum
        }
        cape err {
            adfirma err.continet("payload truncated")
        }
    }

    proba "rejects truncated safetensors payload" {
        # data_offsets [0, 12] but only 8 bytes of payload exist
        fixum octeti data ← |3a 00 00 00 00 00 00 00 7b 22 74 65 73 74 22 3a 7b 22 64 74 79 70 65 22 3a 22 46 33 32 22 2c 22 73 68 61 70 65 22 3a 5b 32 5d 2c 22 64 61 74 61 5f 6f 66 66 73 65 74 73 22 3a 5b 30 2c 31 32 5d 7d 7d 00 00 80 3f 00 00 00 40|
        fac {
            fixum ModelSummary summary ← safetensors_summarium("fixture", "fixture", "fixture.safetensors", data)
            fixum MetadataTensor info ← summary.tensors[0]
            fixum lista<f32> _ ← safetensors_tensor_f32(data, info)
            adfirma falsum
        }
        cape err {
            adfirma err.continet("payload truncated")
        }
    }

    proba "rejects safetensors element count mismatch" {
        # shape [3] → 3 elements expected, but data_offsets span 8 bytes = 2 elements
        fixum octeti data ← |39 00 00 00 00 00 00 00 7b 22 74 65 73 74 22 3a 7b 22 64 74 79 70 65 22 3a 22 46 33 32 22 2c 22 73 68 61 70 65 22 3a 5b 33 5d 2c 22 64 61 74 61 5f 6f 66 66 73 65 74 73 22 3a 5b 30 2c 38 5d 7d 7d 00 00 80 3f 00 00 00 40|
        fac {
            fixum ModelSummary summary ← safetensors_summarium("fixture", "fixture", "fixture.safetensors", data)
            fixum MetadataTensor info ← summary.tensors[0]
            fixum lista<f32> _ ← safetensors_tensor_f32(data, info)
            adfirma falsum
        }
        cape err {
            adfirma err.continet("element count mismatch")
        }
    }

    proba "tempta variant returns nihil on error and value on success" {
        # Success case: valid F32 tensor
        fixum octeti valid ← |39 00 00 00 00 00 00 00 7b 22 74 65 73 74 22 3a 7b 22 64 74 79 70 65 22 3a 22 46 33 32 22 2c 22 73 68 61 70 65 22 3a 5b 32 5d 2c 22 64 61 74 61 5f 6f 66 66 73 65 74 73 22 3a 5b 30 2c 38 5d 7d 7d 00 00 80 3f 00 00 00 40|
        fac {
            fixum ModelSummary summary ← safetensors_summarium("fixture", "fixture", "fixture.safetensors", valid)
            fixum MetadataTensor info ← summary.tensors[0]
            fixum lista<f32> ∪ nihil ok_result ← tempta_safetensors_tensor_f32(valid, info)
            adfirma ok_result non est nihil
        }
        cape err {
            adfirma falsum
        }

        # Error case: non-F32 dtype — should return nihil without throwing
        fixum octeti bad ← |3a 00 00 00 00 00 00 00 7b 22 74 65 73 74 22 3a 7b 22 64 74 79 70 65 22 3a 22 49 36 34 22 2c 22 73 68 61 70 65 22 3a 5b 32 5d 2c 22 64 61 74 61 5f 6f 66 66 73 65 74 73 22 3a 5b 30 2c 31 36 5d 7d 7d 01 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00|
        fac {
            fixum ModelSummary bad_summary ← safetensors_summarium("fixture", "fixture", "bad.safetensors", bad)
            fixum MetadataTensor bad_info ← bad_summary.tensors[0]
            fixum lista<f32> ∪ nihil fail_result ← tempta_safetensors_tensor_f32(bad, bad_info)
            adfirma fail_result est nihil
        }
        cape err {
            adfirma falsum
        }
    }

