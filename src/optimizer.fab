+++
locale = "en"
+++

# optimizer.fab — minimal SGD optimizer step
#
# Public import: importa ex "norma:optimizer" privata optimizer
#
# One shape-generic SGD step covering tensor<f32, [4]>, [2,2], [1,2], and []
# shapes (previously four concrete overloads; the magnitudo Figura param
# makes them one function).
#
# SGD update: param -= lr * grad   (same-shape tensors, elementwise).
# Element type is f32 (reverse-AD AIR lane requires f32/tf32 tensors).

# -------------------------------------------------------------------------
# SGD step (shape-generic: magnitudo Figura binds implicitly at call sites)
# -------------------------------------------------------------------------

fn sgd_step<size Figura>(tensor<f32, Figura> param, tensor<f32, Figura> grad, f32 lr) → tensor<f32, Figura> {
    const tensor<f32, Figura> lr_fill ← param.fill(lr)
    const tensor<f32, Figura> scaled ← grad.multiply(lr_fill)
    return param.subtract(scaled)
}
