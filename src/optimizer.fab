# -------------------------------------------------------------------------
# SGD step (tensor<f32, []>, Stage E5 scalar shape for rung-4)
# -------------------------------------------------------------------------

functio sgd_step_0d(
    tensor<f32, []> param,
    tensor<f32, []> grad,
    f32 lr
) → tensor<f32, []> {
    fixum lista<numerus> shape ← param.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, []> lr_fill ← seed.crea(lr, shape)
    fixum tensor<f32, []> scaled ← grad.multiplica(lr_fill)
    redde param.subtrahe(scaled)
}
