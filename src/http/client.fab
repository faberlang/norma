+++
locale = "en"
+++

# http/client.fab — HTTP client verbs
#
# Public import: import from "norma:http/client" client
# Depends on: norma:http/headers, norma:http/response
#
# URL split, header assembly, Client agent reuse, and I/O verbs over
# dispatched http:* client routes:
#   http:agent           [] or [timeout_ms] → handle
#   http:get|delete      [url] | [url, headers] | [agent, url] | [agent, url, headers]
#   http:post|put|patch  [url, body] | [url, headers, body] | [agent, …]
#   http:request         [method, url, headers, body] | [agent, method, url, headers, body]
#   http:request_open    same arity as http:request → {reader, status, headers}
#   http:read            [reader] | [reader, max_bytes] → {bytes, done}
# Streaming receive pulls one bounded chunk per call (never read_to_end)
# so an SSE consumer can parse events as they arrive.

import from "norma:http/headers" headers
import from "norma:http/response" response

# Minimal origin-form split (scheme/host/port/path/query). No standalone
# URL genus elsewhere — design killed that leaf for v1.
@ public
class Url {
    string scheme = ""
    string host = ""
    int port = 0
    string path = ""
    string query = ""
}

# Reuse holder. `agent` is the http:agent handle; 0 means ephemeral
# (the provider builds a one-shot agent for that call).
@ public
class Client {
    int agent = 0
}

# Incremental receive handle from http:request_open. `next` / `next_n`
# pull one chunk via http:read; they never drain the remainder.
@ public
class Receive {
    int reader = 0
    int status = 0
    headers.Headers headers = headers.Headers { }

    @ public
    fn next() → Chunk {
        return receive(self)
    }

    @ public
    fn next_n(int max_bytes) → Chunk {
        return receive_n(self, max_bytes)
    }
}

# One incremental body chunk. `text` is the UTF-8 decode of this read
# (empty when the bytes are not UTF-8). `done` is true only on the
# terminal read; a later receive after done fails at the provider.
@ public
class Chunk {
    string text = ""
    bool done = false
}

@ public
fn empty() → Client {
    return Client { }
}

# Create a reusable agent (provider default timeout).
@ public
fn session() → Client {
    const list<value> none ← empty
    const int handle ← call 'http:agent' (none) ↦ int
    return Client { agent = handle }
}

# Create a reusable agent with an explicit timeout in milliseconds.
@ public
fn session_timeout(int timeout_ms) → Client {
    const int handle ← call 'http:agent' ([timeout_ms ↦ value]) ↦ int
    return Client { agent = handle }
}

# Split an absolute URL. Invalid input yields an empty scheme (no host).
# Default ports: http 80, https 443. Empty path becomes `/`. Fragment
# is dropped. Port, when present, must be between 1 and 65535.
@ public
fn split(string url) → Url {
    const int sep ← _find_scheme_sep(url)
    if sep < 0 then return Url { }
    const string scheme ← _ascii_lower(url.slice(0, sep))
    if not _is_scheme(scheme) then return Url { }
    const string rest ← url.slice(sep + 3, url.length())
    const int auth_end ← _authority_end(rest)
    if auth_end < 0 then return Url { }
    const string authority ← rest.slice(0, auth_end)
    const string remainder ← rest.slice(auth_end, rest.length())
    const string hostport ← _strip_userinfo(authority)
    const string host ← _ascii_lower(_host_of(hostport))
    if host.length() ≡ 0 then return Url { }
    if not _is_host(host) then return Url { }
    const int ∪ null port ← _port_of(hostport, scheme)
    if port is null then return Url { }
    const string path ← _remainder_path(remainder)
    const string query ← _remainder_query(remainder)
    return Url {
        scheme = scheme,
        host = host,
        port = port ↦ int,
        path = path,
        query = query
    }
}

@ public
fn is_absolute(Url url) → bool {
    return url.scheme.length() > 0 and url.host.length() > 0
}

# Host header value: omit the port when it is the scheme default.
@ public
fn host_header(Url url) → string {
    if _is_default_port(url.scheme, url.port) {
        return _host_literal(url.host)
    }
    return "§:§"(_host_literal(url.host), url.port ↦ string)
}

# Origin-form request target (`/path` or `/path?query`).
@ public
fn request_target(Url url) → string {
    if url.query.length() ≡ 0 {
        return url.path
    }
    return "§?§"(url.path, url.query)
}

# Fold a name→value map into the shared Headers genus (illegal lines dropped).
@ public
fn headers_from_map(map<string, string> pairs) → headers.Headers {
    var headers.Headers out ← headers.empty()
    const list<string> names ← pairs.keys()
    for from names const name {
        const string ∪ null value ← pairs.get(name)
        if value not is null {
            if out.append(name, value ↦ string) {
            }
        }
    }
    return out
}

@ public
fn get(string url) → response.Response {
    return _no_body("http:get", 0, url, headers.empty())
}

@ public
fn get_with(string url, headers.Headers headers) → response.Response {
    return _no_body("http:get", 0, url, headers)
}

@ public
fn get_on(Client client, string url) → response.Response {
    return _no_body("http:get", client.agent, url, headers.empty())
}

@ public
fn post(string url, string body) → response.Response {
    return _with_body("http:post", 0, url, headers.empty(), body)
}

@ public
fn post_with(string url, headers.Headers headers, string body) → response.Response {
    return _with_body("http:post", 0, url, headers, body)
}

@ public
fn post_on(Client client, string url, string body) → response.Response {
    return _with_body("http:post", client.agent, url, headers.empty(), body)
}

@ public
fn put(string url, string body) → response.Response {
    return _with_body("http:put", 0, url, headers.empty(), body)
}

@ public
fn put_with(string url, headers.Headers headers, string body) → response.Response {
    return _with_body("http:put", 0, url, headers, body)
}

@ public
fn put_on(Client client, string url, string body) → response.Response {
    return _with_body("http:put", client.agent, url, headers.empty(), body)
}

@ public
fn delete(string url) → response.Response {
    return _no_body("http:delete", 0, url, headers.empty())
}

@ public
fn delete_with(string url, headers.Headers headers) → response.Response {
    return _no_body("http:delete", 0, url, headers)
}

@ public
fn delete_on(Client client, string url) → response.Response {
    return _no_body("http:delete", client.agent, url, headers.empty())
}

@ public
fn patch(string url, string body) → response.Response {
    return _with_body("http:patch", 0, url, headers.empty(), body)
}

@ public
fn patch_with(string url, headers.Headers headers, string body) → response.Response {
    return _with_body("http:patch", 0, url, headers, body)
}

@ public
fn patch_on(Client client, string url, string body) → response.Response {
    return _with_body("http:patch", client.agent, url, headers.empty(), body)
}

@ public
fn send_request(string method, string url, map<string, string> pairs, string body) → response.Response {
    return send(method, url, headers_from_map(pairs), body)
}

@ public
fn send(string method, string url, headers.Headers headers, string body) → response.Response {
    return _generic("http:request", 0, method, url, headers, body)
}

@ public
fn send_on(Client client, string method, string url, headers.Headers headers, string body) → response.Response {
    return _generic("http:request", client.agent, method, url, headers, body)
}

# Open a streaming receive. The body is not buffered; pull chunks with
# receive / Receive.next. Designed for text/event-stream consumption.
@ public
fn open(string method, string url, headers.Headers headers, string body) → Receive {
    return _open(0, method, url, headers, body)
}

@ public
fn open_on(Client client, string method, string url, headers.Headers headers, string body) → Receive {
    return _open(client.agent, method, url, headers, body)
}

@ public
fn receive(Receive stream) → Chunk {
    const list<value> args ← [stream.reader ↦ value]
    return _chunk_of(call 'http:read' (args) ↦ value)
}

@ public
fn receive_n(Receive stream, int max_bytes) → Chunk {
    const list<value> args ← [stream.reader ↦ value, max_bytes ↦ value]
    return _chunk_of(call 'http:read' (args) ↦ value)
}

fn _require_url(string url, string verb) → void {
    const Url parsed ← split(url)
    if not is_absolute(parsed) {
        panic "norma:http/client.§: invalid URL"(verb)
    }
    return
}

fn _no_body(string route, int agent, string url, headers.Headers headers) → response.Response {
    _require_url(url, route)
    var list<value> args ← empty
    if agent > 0 {
        args.append(agent ↦ value)
    }
    args.append(url ↦ value)
    if headers.length() > 0 {
        args.append(_headers_carrier(headers) ↦ value)
    }
    if route ≡ "http:get" {
        return _response_of(call 'http:get' (args) ↦ value)
    }
    return _response_of(call 'http:delete' (args) ↦ value)
}

fn _with_body(string route, int agent, string url, headers.Headers headers, string body) → response.Response {
    _require_url(url, route)
    var list<value> args ← empty
    if agent > 0 {
        args.append(agent ↦ value)
    }
    args.append(url ↦ value)
    if headers.length() > 0 {
        args.append(_headers_carrier(headers) ↦ value)
    }
    args.append(body ↦ value)
    if route ≡ "http:post" {
        return _response_of(call 'http:post' (args) ↦ value)
    }
    if route ≡ "http:put" {
        return _response_of(call 'http:put' (args) ↦ value)
    }
    return _response_of(call 'http:patch' (args) ↦ value)
}

fn _generic(string route, int agent, string method, string url, headers.Headers headers, string body) → response.Response {
    _require_url(url, route)
    const value raw ← _dispatch_generic(route, agent, method, url, headers, body)
    return _response_of(raw)
}

fn _open(int agent, string method, string url, headers.Headers headers, string body) → Receive {
    _require_url(url, "http:request_open")
    const value raw ← _dispatch_generic("http:request_open", agent, method, url, headers, body)
    const map<string, value> fields ← raw ↦ map<string, value>
    return Receive {
        reader = fields["reader"] ↦ int,
        status = fields["status"] ↦ int,
        headers = _headers_from_carrier(fields["headers"])
    }
}

fn _dispatch_generic(string route, int agent, string method, string url, headers.Headers headers, string body) → value {
    var list<value> args ← empty
    if agent > 0 {
        args.append(agent ↦ value)
    }
    args.append(method ↦ value)
    args.append(url ↦ value)
    args.append(_headers_carrier(headers) ↦ value)
    args.append(body ↦ value)
    if route ≡ "http:request_open" {
        return call 'http:request_open' (args) ↦ value
    }
    return call 'http:request' (args) ↦ value
}

fn _response_of(value raw) → response.Response {
    const map<string, value> fields ← raw ↦ map<string, value>
    return response.of(
        fields["status"] ↦ int,
        _headers_from_carrier(fields["headers"]),
        _body_text(fields["body"])
    )
}

fn _chunk_of(value raw) → Chunk {
    const map<string, value> fields ← raw ↦ map<string, value>
    return Chunk {
        text = _body_text(fields["bytes"]),
        done = fields["done"] ↦ bool
    }
}

fn _headers_carrier(headers.Headers headers) → list<value> {
    var list<value> out ← empty
    for from headers.entries const entry {
        var map<string, value> row ← empty
        row.put("name", entry.name ↦ value)
        row.put("value", entry.value ↦ value)
        out.append(row ↦ value)
    }
    return out
}

fn _headers_from_carrier(value raw) → headers.Headers {
    var headers.Headers out ← headers.empty()
    if raw not is list<value> then return out
    const list<value> items ← raw ↦ list<value>
    for from items const item {
        if item is map<string, value> {
            const map<string, value> row ← item ↦ map<string, value>
            const string name ← row["name"] ↦ string
            const string header_value ← row["value"] ↦ string
            if out.append(name, header_value) {
            }
        }
    }
    return out
}

fn _body_text(value raw) → string {
    if raw is null then return ""
    if raw is string then return raw ↦ string
    do {
        const bytes data ← raw ↦ bytes
        do {
            return data ↦ string
        }
        catch err {
            return ""
        }
    }
    catch err {
        return ""
    }
}

fn _find_scheme_sep(string url) → int {
    var int i ← 0
    while i + 2 < url.length() {
        if url.slice(i, i + 3) ≡ "://" {
            return i
        }
        i ← i + 1
    }
    return -1
}

fn _is_scheme(string scheme) → bool {
    if scheme.length() ≡ 0 then return false
    if not _is_alpha(scheme.slice(0, 1)) then return false
    var int i ← 1
    while i < scheme.length() {
        const string c ← scheme.slice(i, i + 1)
        if not _is_alpha(c) and not _is_digit(c) and c ≠ "+" and c ≠ "-" and c ≠ "." {
            return false
        }
        i ← i + 1
    }
    return true
}

fn _authority_end(string rest) → int {
    if rest.length() ≡ 0 then return -1
    var int i ← 0
    var bool v6 ← false
    while i < rest.length() {
        const string c ← rest.slice(i, i + 1)
        if c ≡ "[" {
            v6 ← true
        }
        elif c ≡ "]" {
            v6 ← false
        }
        elif not v6 and (c ≡ "/" or c ≡ "?" or c ≡ "#") {
            return i
        }
        i ← i + 1
    }
    return rest.length()
}

fn _strip_userinfo(string authority) → string {
    var int at ← -1
    var int i ← 0
    var bool v6 ← false
    while i < authority.length() {
        const string c ← authority.slice(i, i + 1)
        if c ≡ "[" {
            v6 ← true
        }
        elif c ≡ "]" {
            v6 ← false
        }
        elif c ≡ "@" and not v6 {
            at ← i
        }
        i ← i + 1
    }
    if at < 0 then return authority
    return authority.slice(at + 1, authority.length())
}

fn _host_of(string hostport) → string {
    if hostport.length() ≡ 0 then return ""
    if hostport.slice(0, 1) ≡ "[" {
        var int i ← 1
        while i < hostport.length() {
            if hostport.slice(i, i + 1) ≡ "]" {
                return hostport.slice(1, i)
            }
            i ← i + 1
        }
        return ""
    }
    var int i ← 0
    while i < hostport.length() {
        if hostport.slice(i, i + 1) ≡ ":" {
            return hostport.slice(0, i)
        }
        i ← i + 1
    }
    return hostport
}

fn _port_of(string hostport, string scheme) → int ∪ null {
    if hostport.length() ≡ 0 then return null
    var string digits ← ""
    if hostport.slice(0, 1) ≡ "[" {
        var int i ← 1
        var bool closed ← false
        while i < hostport.length() {
            if hostport.slice(i, i + 1) ≡ "]" {
                closed ← true
                i ← i + 1
                break
            }
            i ← i + 1
        }
        if not closed then return null
        if i ≡ hostport.length() {
            return _default_port(scheme)
        }
        if hostport.slice(i, i + 1) ≠ ":" then return null
        digits ← hostport.slice(i + 1, hostport.length())
    }
    else {
        var int colon ← -1
        var int i ← 0
        while i < hostport.length() {
            if hostport.slice(i, i + 1) ≡ ":" {
                if colon ≥ 0 then return null
                colon ← i
            }
            i ← i + 1
        }
        if colon < 0 {
            return _default_port(scheme)
        }
        digits ← hostport.slice(colon + 1, hostport.length())
    }
    if digits.length() ≡ 0 then return null
    var int i ← 0
    while i < digits.length() {
        if not _is_digit(digits.slice(i, i + 1)) then return null
        i ← i + 1
    }
    do {
        const int n ← digits ↦ int
        if n < 1 or n > 65535 then return null
        return n
    }
    catch err {
        return null
    }
}

fn _default_port(string scheme) → int {
    if scheme ≡ "http" then return 80
    if scheme ≡ "https" then return 443
    return 0
}

fn _is_default_port(string scheme, int port) → bool {
    if scheme ≡ "http" then return port ≡ 80
    if scheme ≡ "https" then return port ≡ 443
    return false
}

fn _is_host(string host) → bool {
    if host.length() ≡ 0 then return false
    var int i ← 0
    while i < host.length() {
        const string c ← host.slice(i, i + 1)
        if c ≡ " " or c ≡ "/" or c ≡ "?" or c ≡ "#" or c ≡ "@" or c ≡ "[" or c ≡ "]" {
            return false
        }
        i ← i + 1
    }
    return true
}

fn _host_literal(string host) → string {
    var int i ← 0
    while i < host.length() {
        if host.slice(i, i + 1) ≡ ":" {
            return "[§]"(host)
        }
        i ← i + 1
    }
    return host
}

fn _remainder_path(string remainder) → string {
    if remainder.length() ≡ 0 then return "/"
    const string first ← remainder.slice(0, 1)
    if first ≡ "?" or first ≡ "#" then return "/"
    var int i ← 0
    while i < remainder.length() {
        const string c ← remainder.slice(i, i + 1)
        if c ≡ "?" or c ≡ "#" {
            const string path ← remainder.slice(0, i)
            if path.length() ≡ 0 then return "/"
            return path
        }
        i ← i + 1
    }
    return remainder
}

fn _remainder_query(string remainder) → string {
    var int i ← 0
    while i < remainder.length() {
        const string c ← remainder.slice(i, i + 1)
        if c ≡ "#" {
            return ""
        }
        if c ≡ "?" {
            const int start ← i + 1
            var int j ← start
            while j < remainder.length() {
                if remainder.slice(j, j + 1) ≡ "#" {
                    return remainder.slice(start, j)
                }
                j ← j + 1
            }
            return remainder.slice(start, remainder.length())
        }
        i ← i + 1
    }
    return ""
}

fn _ascii_lower(string s) → string {
    var string out ← ""
    var int i ← 0
    while i < s.length() {
        out ← out + _lower_char(s.slice(i, i + 1))
        i ← i + 1
    }
    return out
}

fn _lower_char(string c) → string {
    const string upper ← "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    const string lower ← "abcdefghijklmnopqrstuvwxyz"
    var int i ← 0
    while i < 26 {
        if upper.slice(i, i + 1) ≡ c {
            return lower.slice(i, i + 1)
        }
        i ← i + 1
    }
    return c
}

fn _is_alpha(string c) → bool {
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(c)
}

fn _is_digit(string c) → bool {
    return "0123456789".contains(c)
}
