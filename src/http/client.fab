# http/client.fab — HTTP client verbs
#
# Public import: import from "norma:http/client" client
# Depends on: norma:http/response
#
# Verb surface lives here. H5 owns URL split, Agent reuse, and streaming
# receive. The facade re-exports these verbs for `import from "norma:http"`.

import from "norma:http/response" response

@ public
@ future
fn get(string url) → response.Response {
    panic "norma:http.get is deferred pending Stage 2 dispatch"
}

@ public
@ future
fn post(string url, string body) → response.Response {
    panic "norma:http.post is deferred pending Stage 2 dispatch"
}

@ public
@ future
fn put(string url, string body) → response.Response {
    panic "norma:http.put is deferred pending Stage 2 dispatch"
}

@ public
@ future
fn delete(string url) → response.Response {
    panic "norma:http.delete is deferred pending Stage 2 dispatch"
}

@ public
@ future
fn patch(string url, string body) → response.Response {
    panic "norma:http.patch is deferred pending Stage 2 dispatch"
}

@ public
@ future
fn send_request(string method, string url, map<string, string> headers, string body) → response.Response {
    panic "norma:http.send_request is deferred pending Stage 2 dispatch"
}
