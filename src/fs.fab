# =========================================================================
# PATH UTILITIES (proxies — canonical definitions live in norma:solum/path)
# =========================================================================
# These top-level proxies preserve the facade while sharing the canonical
# solum:* routes with norma:solum/path.

# Join path segments
@ public
fn join(list<string> partes) → string {
    return call 'solum:iunge' (partes) ↦ string
}

# Parent path segment (directory part)
@ public
fn parent(string via) → string {
    return call 'solum:parens' (via) ↦ string
}

# Final path segment (filename)
fn file_name(string via) → string {
    return call 'solum:nomen' (via) ↦ string
}

# File extension (includes dot)
fn extension(string via) → string {
    return call 'solum:suffixum' (via) ↦ string
}

# Resolve to absolute path
fn resolve(string via) → string {
    return call 'solum:absolve' (via) ↦ string
}

# Get user's home directory
fn home() → string {
    return call 'solum:domus' ↦ string
}

# Get system temp directory
fn temp_dir() → string {
    return call 'solum:temporarium' ↦ string
}

@ private
fn _join_two(string base, string segmentum) → string {
    if base.ends_with("/") {
        return "§§"(base, segmentum)
    }
    return "§/§"(base, segmentum)
}

# =========================================================================
# SHALLOW GLOB (native composition — v1 single-segment star)
# =========================================================================
#
# Contract: glob(radix, exemplar) → lista<textus> ⇥ textus
# v1: * matches exactly one path segment (e.g. "*/SKILL.md").
#
fn glob(string radix, string exemplar) → list<string> ⇥ string {
    const list<string> segmenta ← exemplar.split("/")
    var list<string> candidatos ← [radix]
    var int index ← 0
    while index < segmenta.length() {
        const string segmentum ← segmenta.get(index) coalesce ""
        if segmentum ≡ "" {
            throw "empty path segment in solum.glob exemplar"
        }

        var list<string> proximos ← []
        if segmentum ≡ "*" {
            for from candidatos const base {
                const list<string> entries ← list_dir(base)
                for from entries const entry {
                    proximos.append(_join_two(base, entry))
                }
            }
        }
        else {
            for from candidatos const base {
                const string via ← _join_two(base, segmentum)
                if exists(via) {
                    proximos.append(via)
                }
            }
        }

        candidatos ← proximos
        index ← index + 1
    }
    return candidatos
}
