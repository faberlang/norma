+++
locale = "en"
+++

# solum.fab - File System Device
#
# Etymology: "solum" - ground, floor, base. Local/ground I/O (vs caelum/sky/network).
#
# Operations route over `ad`; stat/stat_async remain explicit panic stubs until
# Stage 2 can materialize FileStatus values.
# Top-level path operations proxy norma:solum/path for compatibility.
#
# Sync and async wrappers use the same `ad` frame contract; `@ future` marks the
# async caller posture. Text, bytes, and lines use distinct public operations.


# =============================================================================
# TYPES
# =============================================================================

# Full file status returned by stat/stat_async
# Maps to: stat(), lstat()
class FileStatus {
    int mode
    # permission bits (e.g., 0o755)
    int link_count
    # hard link count
    int owner
    # owner uid
    int group
    # group gid
    int byte_length
    # size in bytes
    int modified
    # mtime (ms since epoch)
    bool is_directory
    bool is_symlink
}

# =========================================================================
# READING - Text
# =========================================================================
# Maps to: fs.readFileSync(path, 'utf8') / fs.readFile(path, 'utf8')

# Read entire file as text (sync)
@ public
@ radix type T mut string list<string> bytes
fn read_file<T>(string via) → T {
    return call 'solum:lege' (via) ↦ T
}

# Read entire file as text with async caller materialization.
@ public
@ radix type T mut string list<string> bytes
@ future
fn read_file_async<T>(string via) → T {
    return call 'solum:lege' (via) ↦ T
}

# =========================================================================
# READING - Bytes
# =========================================================================
# Maps to: fs.readFileSync(path) / fs.readFile(path) returning Buffer

# Draw entire file as bytes (sync)
fn read_bytes(string via) → bytes {
    return call 'solum:hauri' (via) ↦ bytes
}

# Draw entire file as bytes (async route; Faber blocks on the frame)
@ future
fn read_bytes_async(string via) → bytes {
    return call 'solum:hauriet' (via) ↦ bytes
}

# Draw a bounded byte range from a file.
@ public
fn read_range(string via, int initium, int longitudo) → bytes {
    const list<value> args ← [via ↦ value, initium ↦ value, longitudo ↦ value]
    return call 'solum:partem' (args) ↦ bytes
}

# Find a text byte pattern within a bounded file range, or -1 when absent.
fn find(string via, string exemplar, int initium, int longitudo) → int {
    const list<value> args ← [via ↦ value, exemplar ↦ value, initium ↦ value, longitudo ↦ value]
    return call 'solum:inveni' (args) ↦ int
}

# =========================================================================
# READING - Lines
# =========================================================================
# Maps to: readline interface or line-by-line file reading

# Pluck lines from file (sync)
@ public
fn read_lines(string via) → list<string> {
    return call 'solum:carpe' (via) ↦ list<string>
}

# Pluck lines from file (async route; Faber blocks on the frame)
@ future
fn read_lines_async(string via) → list<string> {
    return call 'solum:carpiet' (via) ↦ list<string>
}

# =========================================================================
# WRITING - Text
# =========================================================================
# Maps to: fs.writeFileSync(path, data, 'utf8') / fs.writeFile(...)

# Write text to file, overwrites existing (sync)
@ public
fn write_file(string via, string data) → void {
    return call 'solum:scribe' ([via, data]) ↦ void
}

# Write text to file, overwrites existing (async route; Faber blocks)
@ future
fn write_file_async(string via, string data) → void {
    return call 'solum:scribet' ([via, data]) ↦ void
}

# =========================================================================
# WRITING - Bytes
# =========================================================================
# Maps to: fs.writeFileSync(path, buffer) / fs.writeFile(path, buffer)

# Pour bytes to file, overwrites existing (sync)
@ public
fn write_bytes(string via, bytes data) → void {
    const list<value> args ← [via ↦ value, data ↦ value]
    return call 'solum:funde' (args) ↦ void
}

# Pour bytes to file with async caller materialization.
@ public
@ future
fn write_bytes_async(string via, bytes data) → void {
    const list<value> args ← [via ↦ value, data ↦ value]
    return call 'solum:funde' (args) ↦ void
}

# =========================================================================
# WRITING - Append
# =========================================================================
# Maps to: fs.appendFileSync(path, data) / fs.appendFile(path, data)

# Append text to file (sync)
fn append(string via, string data) → void {
    return call 'solum:appone' ([via, data]) ↦ void
}

# Append text to file (async route; Faber blocks)
@ future
fn append_async(string via, string data) → void {
    return call 'solum:apponet' ([via, data]) ↦ void
}

# =========================================================================
# FILE INFO - Existence
# =========================================================================
# Maps to: fs.existsSync(path) / fs.access(path)

# Check if path exists (sync)
@ public
fn exists(string via) → bool {
    return call 'solum:exstat' (via) ↦ bool
}

# Check if path exists (async route; Faber blocks)
@ future
fn exists_async(string via) → bool {
    return call 'solum:exstabit' (via) ↦ bool
}

# True when path metadata says directory.
@ public
fn is_directory(string via) → bool {
    return call 'solum:directoriumne' (via) ↦ bool
}

# True when path metadata says regular file.
@ public
fn is_regular(string via) → bool {
    return call 'solum:regularene' (via) ↦ bool
}

# True when path is a regular file and can be opened for reading.
fn is_readable(string via) → bool {
    return call 'solum:legibilene' (via) ↦ bool
}

# True when path itself is a symbolic link.
@ public
fn is_symlink(string via) → bool {
    return call 'solum:vinculumne' (via) ↦ bool
}

# File size in bytes.
@ public
fn byte_length(string via) → int {
    return call 'solum:mensura' (via) ↦ int
}

# Permission/mode bits as a numeric value.
@ public
fn mode(string via) → int {
    return call 'solum:modus' (via) ↦ int
}

# =========================================================================
# FILE INFO - Details
# =========================================================================
# Maps to: fs.statSync(path) / fs.stat(path) - uses lstat to not follow symlinks

# Get file details (sync)
# WHY: deferred because the `ad` materializer does not support
# arbitrary genera like SolumStatus — only vacuum, valor, scalars, octeti,
# instans, and lista<T> (empirically confirmed July 2026). Migrating to
# `ad` requires extending the materializer's conversio-valor genus table
# to lower SolumStatus as a Tabula walk. The host gateway work is the
# right moment to land that.
fn stat(string via) → FileStatus {
    panic "norma:solum.stat is deferred pending Stage 2 dispatch"
}

# Get file details (async — same materializer blocker as stat)
@ future
fn stat_async(string via) → FileStatus {
    panic "norma:solum.stat_async is deferred pending Stage 2 dispatch"
}

# =========================================================================
# FILE INFO - Symlinks
# =========================================================================
# Maps to: fs.readlinkSync(path) / fs.readlink(path)

# Follow symlink to get target path (sync)
@ public
fn read_link(string via) → string {
    return call 'solum:sequere' (via) ↦ string
}

# Follow symlink to get target path (async route; Faber blocks)
@ future
fn read_link_async(string via) → string {
    return call 'solum:sequetur' (via) ↦ string
}

# Create a symbolic link pointing from destinatio to fons.
@ public
fn create_link(string fons, string destinatio) → void {
    return call 'solum:vincula' ([fons, destinatio]) ↦ void
}

