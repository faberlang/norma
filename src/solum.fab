+++
locale = "en"
+++

# solum.fab - File System Device
#
# Etymology: "solum" - ground, floor, base. Local/ground I/O (vs caelum/sky/network).
#
# Verbs route over stream `ad` (Latin `solum:*` routes); describe/describet are
# deferred `mori` stubs pending the Stage 2 materializer (see below).
# Path operations are proxied here for surface compatibility; their canonical
# home is norma:solum/path.
#
# Design principles:
# - Sync and async wrappers share the same `ad` route contract; `@ futura`
# marks the caller posture, and Radix selects async materialization.
# - Verb conjugation names the public API posture, not a second host route.
# - Different verbs for different data types (text vs bytes vs lines)
# - No "Latin as paint" - verbs chosen for semantic fit, not translation


# =============================================================================
# TYPES
# =============================================================================

# Full file status returned by describe/describet
# Maps to: stat(), lstat()
class SolumStatus {
    int modus
    # permission bits (e.g., 0o755)
    int nexus
    # hard link count
    int possessor
    # owner uid
    int grex
    # group gid
    int mensura
    # size in bytes
    int modificatum
    # mtime (ms since epoch)
    bool directoriumne
    bool vinculumne
}

# =========================================================================
# READING - Text
# =========================================================================
# Verb: lege/leget from "legere" (to read, gather)
# Maps to: fs.readFileSync(path, 'utf8') / fs.readFile(path, 'utf8')

# Read entire file as text (sync)
@ public
@ radix type T mut string list<string> bytes
fn read<T>(string via) → T {
    return call 'solum:lege' (via) ↦ T
}

# Read entire file as text with async caller materialization.
@ public
@ radix type T mut string list<string> bytes
@ future
fn leget<T>(string via) → T {
    return call 'solum:lege' (via) ↦ T
}

# =========================================================================
# READING - Bytes
# =========================================================================
# Verb: hauri/hauriet from "haurire" (to draw up, draw water)
# Why: Distinct from "reading" text - this is raw byte extraction.
# Maps to: fs.readFileSync(path) / fs.readFile(path) returning Buffer

# Draw entire file as bytes (sync)
fn hauri(string via) → bytes {
    return call 'solum:hauri' (via) ↦ bytes
}

# Draw entire file as bytes (async route; Faber blocks on the frame)
@ future
fn hauriet(string via) → bytes {
    return call 'solum:hauriet' (via) ↦ bytes
}

# Draw a bounded byte range from a file.
@ public
fn partem(string via, int initium, int longitudo) → bytes {
    const list<value> args ← [via ↦ value, initium ↦ value, longitudo ↦ value]
    return call 'solum:partem' (args) ↦ bytes
}

# Find a text byte pattern within a bounded file range, or -1 when absent.
fn inveni(string via, string exemplar, int initium, int longitudo) → int {
    const list<value> args ← [via ↦ value, exemplar ↦ value, initium ↦ value, longitudo ↦ value]
    return call 'solum:inveni' (args) ↦ int
}

# =========================================================================
# READING - Lines
# =========================================================================
# Verb: carpe/carpiet from "carpere" (to pluck, pick, harvest)
# Why: Different from bulk reading - implies iteration/selection.
# Maps to: readline interface or line-by-line file reading

# Pluck lines from file (sync)
@ public
fn carpe(string via) → list<string> {
    return call 'solum:carpe' (via) ↦ list<string>
}

# Pluck lines from file (async route; Faber blocks on the frame)
@ future
fn carpiet(string via) → list<string> {
    return call 'solum:carpiet' (via) ↦ list<string>
}

# =========================================================================
# WRITING - Text
# =========================================================================
# Verb: scribe/scribet from "scribere" (to write)
# Why: Also handles writing lines (text with newlines).
# Maps to: fs.writeFileSync(path, data, 'utf8') / fs.writeFile(...)

# Write text to file, overwrites existing (sync)
@ public
fn write(string via, string data) → void {
    return call 'solum:scribe' ([via, data]) ↦ void
}

# Write text to file, overwrites existing (async route; Faber blocks)
@ future
fn scribet(string via, string data) → void {
    return call 'solum:scribet' ([via, data]) ↦ void
}

# =========================================================================
# WRITING - Bytes
# =========================================================================
# Verb: funde/fundet from "fundere" (to pour, pour out)
# Why: Counterpart to "hauri" (drawing out) - funde pours in.
# Maps to: fs.writeFileSync(path, buffer) / fs.writeFile(path, buffer)

# Pour bytes to file, overwrites existing (sync)
@ public
fn funde(string via, bytes data) → void {
    const list<value> args ← [via ↦ value, data ↦ value]
    return call 'solum:funde' (args) ↦ void
}

# Pour bytes to file with async caller materialization.
@ public
@ future
fn fundet(string via, bytes data) → void {
    const list<value> args ← [via ↦ value, data ↦ value]
    return call 'solum:funde' (args) ↦ void
}

# =========================================================================
# WRITING - Append
# =========================================================================
# Verb: appone/apponet from "apponere" (to place near, add to)
# Why: Not overwriting - appends to what is already there.
# Maps to: fs.appendFileSync(path, data) / fs.appendFile(path, data)

# Append text to file (sync)
fn appone(string via, string data) → void {
    return call 'solum:appone' ([via, data]) ↦ void
}

# Append text to file (async route; Faber blocks)
@ future
fn apponet(string via, string data) → void {
    return call 'solum:apponet' ([via, data]) ↦ void
}

# =========================================================================
# FILE INFO - Existence
# =========================================================================
# Verb: exstat/exstabit from "exstare" (to stand out, exist, be visible)
# Maps to: fs.existsSync(path) / fs.access(path)

# Check if path exists (sync)
@ public
fn exstat(string via) → bool {
    return call 'solum:exstat' (via) ↦ bool
}

# Check if path exists (async route; Faber blocks)
@ future
fn exstabit(string via) → bool {
    return call 'solum:exstabit' (via) ↦ bool
}

# True when path metadata says directory.
@ public
fn directoriumne(string via) → bool {
    return call 'solum:directoriumne' (via) ↦ bool
}

# True when path metadata says regular file.
@ public
fn regularene(string via) → bool {
    return call 'solum:regularene' (via) ↦ bool
}

# True when path is a regular file and can be opened for reading.
fn legibilene(string via) → bool {
    return call 'solum:legibilene' (via) ↦ bool
}

# True when path itself is a symbolic link.
@ public
fn vinculumne(string via) → bool {
    return call 'solum:vinculumne' (via) ↦ bool
}

# File size in bytes.
@ public
fn mensura(string via) → int {
    return call 'solum:mensura' (via) ↦ int
}

# Permission/mode bits as a numeric value.
@ public
fn modus(string via) → int {
    return call 'solum:modus' (via) ↦ int
}

# =========================================================================
# FILE INFO - Details
# =========================================================================
# Verb: describe/describet from "describere" (to write down, delineate, describe)
# Why: Returns full metadata struct, not just existence.
# Maps to: fs.statSync(path) / fs.stat(path) - uses lstat to not follow symlinks

# Get file details (sync)
# WHY: deferred because the `ad` materializer does not support
# arbitrary genera like SolumStatus — only vacuum, valor, scalars, octeti,
# instans, and lista<T> (empirically confirmed July 2026). Migrating to
# `ad` requires extending the materializer's conversio-valor genus table
# to lower SolumStatus as a Tabula walk. The host gateway work is the
# right moment to land that.
fn describe(string via) → SolumStatus {
    panic "norma:solum.describe is deferred pending Stage 2 dispatch"
}

# Get file details (async — same materializer blocker as describe)
@ future
fn describet(string via) → SolumStatus {
    panic "norma:solum.describet is deferred pending Stage 2 dispatch"
}

# =========================================================================
# FILE INFO - Symlinks
# =========================================================================
# Verb: sequere/sequetur from "sequi" (to follow)
# Maps to: fs.readlinkSync(path) / fs.readlink(path)

# Follow symlink to get target path (sync)
@ public
fn sequere(string via) → string {
    return call 'solum:sequere' (via) ↦ string
}

# Follow symlink to get target path (async route; Faber blocks)
@ future
fn sequetur(string via) → string {
    return call 'solum:sequetur' (via) ↦ string
}

# Create a symbolic link pointing from destinatio to fons.
@ public
fn vincula(string fons, string destinatio) → void {
    return call 'solum:vincula' ([fons, destinatio]) ↦ void
}

# =========================================================================
# FILE OPERATIONS - Delete
# =========================================================================
# Verb: dele/delet from "delere" (to destroy, delete, erase)
# Files only - use amputa/amputabit for directories.
# Maps to: fs.unlinkSync(path) / fs.unlink(path)

# Delete file (sync)
@ public
fn dele(string via) → void {
    return call 'solum:dele' (via) ↦ void
}

# Delete file (async route; Faber blocks)
@ future
fn delet(string via) → void {
    return call 'solum:delet' (via) ↦ void
}

# =========================================================================
# FILE OPERATIONS - Copy
# =========================================================================
# Verb: exscribe/exscribet from "exscribere" (to copy out, transcribe)
# Maps to: fs.copyFileSync(src, dest) / fs.copyFile(src, dest)

# Copy file (sync)
@ public
fn exscribe(string fons, string destinatio) → void {
    return call 'solum:exscribe' ([fons, destinatio]) ↦ void
}

# Copy file (async route; Faber blocks)
@ future
fn exscribet(string fons, string destinatio) → void {
    return call 'solum:exscribet' ([fons, destinatio]) ↦ void
}

# =========================================================================
# FILE OPERATIONS - Rename/Move
# =========================================================================
# Verb: renomina/renominabit from "renominare" (to rename)
# Why: Handles both rename and move (same underlying syscall).
# Maps to: fs.renameSync(src, dest) / fs.rename(src, dest)

# Rename or move file (sync)
@ public
fn renomina(string fons, string destinatio) → void {
    return call 'solum:renomina' ([fons, destinatio]) ↦ void
}

# Rename or move file (async route; Faber blocks)
@ future
fn renominabit(string fons, string destinatio) → void {
    return call 'solum:renominabit' ([fons, destinatio]) ↦ void
}

# =========================================================================
# FILE OPERATIONS - Touch
# =========================================================================
# Verb: tange/tanget from "tangere" (to touch)
# Maps to: touch behavior (utimes or create empty file)

# Touch file - create or update mtime (sync)
@ public
fn tange(string via) → void {
    return call 'solum:tange' (via) ↦ void
}

# Touch file - create or update mtime (async route; Faber blocks)
@ future
fn tanget(string via) → void {
    return call 'solum:tanget' (via) ↦ void
}

# Set permission/mode bits.
@ public
fn modum(string via, int modus) → void {
    const list<value> args ← [via ↦ value, modus ↦ value]
    return call 'solum:modum' (args) ↦ void
}

# =========================================================================
# DIRECTORY OPERATIONS - Create
# =========================================================================
# Verb: crea/creabit from "creare" (to create, bring forth)
# Why: Always a directory; recursive by default (creates parent dirs as needed).
# Maps to: fs.mkdirSync(path, {recursive: true}) / fs.mkdir(...)

# Create directory (sync)
@ public
fn crea(string via) → void {
    return call 'solum:crea' (via) ↦ void
}

# Create directory (async route; Faber blocks)
@ future
fn creabit(string via) → void {
    return call 'solum:creabit' (via) ↦ void
}

# =========================================================================
# DIRECTORY OPERATIONS - List
# =========================================================================
# Verb: enumera/enumerabit from "enumerare" (to count out, enumerate)
# Maps to: fs.readdirSync(path) / fs.readdir(path)

# List directory contents (sync)
fn enumera(string via) → list<string> {
    return call 'solum:enumera' (via) ↦ list<string>
}

# List directory contents (async route; Faber blocks)
@ future
fn enumerabit(string via) → list<string> {
    return call 'solum:enumerabit' (via) ↦ list<string>
}

# =========================================================================
# DIRECTORY OPERATIONS - Prune/Remove
# =========================================================================
# Verb: amputa/amputabit from "amputare" (to cut off, prune)
# Why: Recursive deletion - removes directory and all contents.
# Avoids "puto" which also means "to think".
# Maps to: fs.rmSync(path, {recursive: true}) / fs.rm(...)

# Prune directory tree (sync)
@ public
fn amputa(string via) → void {
    return call 'solum:amputa' (via) ↦ void
}

# Prune directory tree (async route; Faber blocks)
@ future
fn amputabit(string via) → void {
    return call 'solum:amputabit' (via) ↦ void
}

# =========================================================================
# PATH UTILITIES (proxies — canonical definitions live in norma:solum/path)
# =========================================================================
# These proxy the path operations so the solum public surface is preserved
# for the kernel manifest, MIR stepper dispatch, and existing callers. The
# canonical Faber definitions live in norma:solum/path; both surfaces route
# to the same solum:* ad route handlers. New code should
# prefer the norma:solum/path import; these remain for surface compatibility.

# Join path segments
@ public
fn iunge(list<string> partes) → string {
    return call 'solum:iunge' (partes) ↦ string
}

# Parent path segment (directory part)
@ public
fn parens(string via) → string {
    return call 'solum:parens' (via) ↦ string
}

# Final path segment (filename)
fn nomen(string via) → string {
    return call 'solum:nomen' (via) ↦ string
}

# File extension (includes dot)
fn suffixum(string via) → string {
    return call 'solum:suffixum' (via) ↦ string
}

# Resolve to absolute path
fn absolve(string via) → string {
    return call 'solum:absolve' (via) ↦ string
}

# Get user's home directory
fn domus() → string {
    return call 'solum:domus' ↦ string
}

# Get system temp directory
fn temporarium() → string {
    return call 'solum:temporarium' ↦ string
}

@ private
fn _iunge_duo(string base, string segmentum) → string {
    if base.ends_with("/") {
        return "§§"(base, segmentum)
    }
    return "§/§"(base, segmentum)
}

# =========================================================================
# SHALLOW GLOB (native composition — v1 single-segment star)
# =========================================================================
#
# Contract: explora(radix, exemplar) → lista<textus> ⇥ textus
# v1: * matches exactly one path segment (e.g. "*/SKILL.md").
#
fn explora(string radix, string exemplar) → list<string> ⇥ string {
    const list<string> segmenta ← exemplar.split("/")
    var list<string> candidatos ← [radix]
    var int index ← 0
    while index < segmenta.length() {
        const string segmentum ← segmenta.get(index) coalesce ""
        if segmentum ≡ "" {
            throw "empty path segment in solum.explora exemplar"
        }

        var list<string> proximos ← vacua
        if segmentum ≡ "*" {
            for from candidatos const base {
                const list<string> nomina ← enumera(base)
                for from nomina const nomen {
                    proximos.append(_iunge_duo(base, nomen))
                }
            }
        }
        else {
            for from candidatos const base {
                const string via ← _iunge_duo(base, segmentum)
                if exstat(via) {
                    proximos.append(via)
                }
            }
        }

        candidatos ← proximos
        index ← index + 1
    }
    return candidatos
}
