+++
locale = "en"
+++

# csv.fab — naive comma / Faber-literal-\n CSV wire helpers (native Faber leaf)
#
# Public import: importa ex "norma:csv" privata csv
# Method ledger: docs/stdlib/csv-methods.md
# Internal dependency: norma:chorda (discissa + nexa)

import from "norma:chorda" chorda

# Why: Strip a single trailing CR when rows arrive CRLF-split (v1 LF contract).
@ private
fn _normaliza_row(string row) → string {
    if row.length() ≡ 0 then return row

    const string last ← row.slice(row.length() - 1, row.length())
    if last ≡ "\r" then return row.slice(0, row.length() - 1)

    return row
}

# Verb: solve from "solvere" (to loosen, untangle)
# Why: Parse naive comma/LF wire into rows of fields (see csv-methods.md for limits).
@ public
fn solve(string wire) → list<list<string>> {
    if wire.length() ≡ 0 then return vacua

    const list<string> rows ← chorda.discissa(wire, "\n", wire.length() + 1)
    var list<list<string>> map ← vacua
    for from rows const row {
        const string normalized ← _normaliza_row(row)
        map.append(chorda.discissa(normalized, ",", normalized.length() + 1))
    }
    return map
}

# Verb: pange from "pangere" (to fasten, compose)
# Why: Compose rows of fields into comma-separated, LF-joined wire text.
@ public
fn pange(list<list<string>> map) → string {
    var list<string> rows ← vacua
    for from map const fields {
        rows.append(chorda.nexa(fields, ","))
    }
    return chorda.nexa(rows, "\n")
}
