# caelum/connexus.fab — TCP socket (connected byte stream)
#
# Public import: importa ex "norma:caelum/connexus" privata connexus
# Depends on: norma:caelum/terminus (for Terminus type in remotus()/localis())

import from "norma:caelum/terminus" terminus

class Connexus {
    int id = 0

    # Draw bytes (up to n if provided, otherwise whatever is available)
    fn hauri(int n optional) → bytes {
        panic "norma:caelum/connexus.hauri is deferred pending Stage 2 dispatch"
    }

    @ future
    fn hauriet(int n optional) → bytes {
        panic "norma:caelum/connexus.hauriet is deferred pending Stage 2 dispatch"
    }

    # Pour bytes
    fn funde(bytes data) → void {
        panic "norma:caelum/connexus.funde is deferred pending Stage 2 dispatch"
    }

    @ future
    fn fundet(bytes data) → void {
        panic "norma:caelum/connexus.fundet is deferred pending Stage 2 dispatch"
    }

    # Close connection
    fn claude() → void {
        panic "norma:caelum/connexus.claude is deferred pending Stage 2 dispatch"
    }

    # Remote endpoint
    fn remotus() → terminus.Terminus {
        panic "norma:caelum/connexus.remotus is deferred pending Stage 2 dispatch"
    }

    # Local endpoint
    fn localis() → terminus.Terminus {
        panic "norma:caelum/connexus.localis is deferred pending Stage 2 dispatch"
    }
}
