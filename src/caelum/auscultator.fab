# caelum/auscultator.fab — TCP listener
#
# Public import: importa ex "norma:caelum/auscultator" privata auscultator
# Depends on: norma:caelum/connexus (for Socket type in accept())

import from "norma:caelum/connexus" connexus

class Listener {
    int id = 0

    # Accept next incoming connection
    fn accept() → connexus.Socket {
        panic "norma:caelum/auscultator.accept is deferred pending Stage 2 dispatch"
    }

    @ future
    fn accept_async() → connexus.Socket {
        panic "norma:caelum/auscultator.accept_async is deferred pending Stage 2 dispatch"
    }

    # Stop listening
    fn close() → void {
        panic "norma:caelum/auscultator.close is deferred pending Stage 2 dispatch"
    }

    # Local port
    fn port() → int {
        panic "norma:caelum/auscultator.port is deferred pending Stage 2 dispatch"
    }
}
