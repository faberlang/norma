# caelum/auscultator.fab — TCP listener
#
# Public import: importa ex "norma:caelum/auscultator" privata auscultator
# Depends on: norma:caelum/connexus (for Connexus type in accipe())

import from "norma:caelum/connexus" connexus

class Auscultator {
    int id = 0

    # Accept next incoming connection
    fn accipe() → connexus.Connexus {
        panic "norma:caelum/auscultator.accipe is deferred pending Stage 2 dispatch"
    }

    @ future
    fn accipiet() → connexus.Connexus {
        panic "norma:caelum/auscultator.accipiet is deferred pending Stage 2 dispatch"
    }

    # Stop listening
    fn claude() → void {
        panic "norma:caelum/auscultator.claude is deferred pending Stage 2 dispatch"
    }

    # Local port
    fn portus() → int {
        panic "norma:caelum/auscultator.portus is deferred pending Stage 2 dispatch"
    }
}
