@ public
fn solve(string toml) → value {
    panic "norma:toml.solve is deferred pending Stage 2 dispatch"
}
fn tempta(string toml) → value ∪ null {
    panic "norma:toml.tempta is deferred pending Stage 2 dispatch"
}
