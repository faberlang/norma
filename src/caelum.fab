# caelum.fab - Network Socket Device (TCP/UDP)
#
# Public import: importa ex "norma:caelum" privata caelum
# Method ledger: docs/design/caelum-methods.md
# Sub-modules:
#   norma:caelum/terminus    — TCP endpoint type
#   norma:caelum/connexus    — connected socket (depends on terminus)
#   norma:caelum/auscultator — listener (depends on connexus)
#
# Etymology: "caelum" - sky, ether. The transport layer beneath HTTP.
# Counterpart to solum (ground/local I/O).
#
# Design notes:
# - Verb conjugation encodes sync/async:
# - Imperative (-a, -e, -i): synchronous (blocking)
# - Future indicative (-et, -ebit): asynchronous
# - TLS enabled via optional cert/key params (listen) or tute flag (connect)
# - TCP: listen/listen_async, connect/connect_async
# - Sockets are bidirectional byte streams

import from "norma:caelum/terminus" terminus
import from "norma:caelum/connexus" connexus
import from "norma:caelum/auscultator" auscultator


# =========================================================================
# TCP SERVER
# =========================================================================

# Create TCP listener (TLS when cert/key provided)
fn listen(int port, string cert optional, string key optional) → auscultator.Listener {
    panic "norma:caelum.listen is deferred pending Stage 2 dispatch"
}

@ future
fn listen_async(int port, string cert optional, string key optional) → auscultator.Listener {
    panic "norma:caelum.listen_async is deferred pending Stage 2 dispatch"
}

# =========================================================================
# TCP CLIENT
# =========================================================================

# Connect to TCP server (TLS when tute=verum)
fn connect(string host, int port, bool tute optional coalesce false) → connexus.Socket {
    panic "norma:caelum.connect is deferred pending Stage 2 dispatch"
}

@ future
fn connect_async(string host, int port, bool tute optional coalesce false) → connexus.Socket {
    panic "norma:caelum.connect_async is deferred pending Stage 2 dispatch"
}
