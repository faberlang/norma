+++
locale = "en"
+++

# valor.fab — codec-agnostic valor tree navigation
#
# Shared surface for the tree-shaped codecs under the flat codec modules (json, toml, yaml).
# Each codec owns its wire floor; this module owns the operations on the
# valor tree shape they all produce. CSV is excluded — it produces a flat
# list<list<string>>, not a valor tree.
#
# No Rust backing. Variant discrimination uses `is` (tag check without
# extraction) and typed read uses `↦` (extraction). The conversio-cascade
# pattern that previously lived in json.fab and toml.fab is retired here
# in favor of the flat `is` dispatch.

import from "norma:chorda" chorda

# =========================================================================
# SHAPE PREDICATES
# =========================================================================
# One-line `is` tag checks. The runtime enum is sibling
# faber/runtime/rust/src/valor.rs.

@ public
fn is_null(value v) → bool {
    return v is null
}

@ public
fn is_bool(value v) → bool {
    return v is bool
}

@ public
fn is_string(value v) → bool {
    return v is string
}

@ public
fn is_int(value v) → bool {
    return v is int
}

@ public
fn is_float(value v) → bool {
    return v is float
}

@ public
fn is_list(value v) → bool {
    return v is list<value>
}

@ public
fn is_map(value v) → bool {
    return v is map<string, value>
}

# Instans is the RFC3339 datetime wire form (Valor::Instans). Available to
# all tree codecs — previously toml-only, now shared.
@ public
fn is_instant(value v) → bool {
    return v is instant
}

# =========================================================================
# VALUE ACCESS
# =========================================================================
# All accessors return null for missing keys, out-of-bounds indices, and
# non-collection variants. Callers distinguish "absent" from "wrong shape"
# via the predicates above if they care.

# Get value by key from a map (returns null if missing or non-map).
@ private
fn _get(value v, string clavis) → value {
    if v is null then return null
    if v not is map<string, value> then return null
    const map<string, value> tab ← v ↦ map<string, value>
    const value got ← tab.get(clavis)
    return got
}

@ public
fn get(value v, string clavis) → value {
    return _get(v, clavis)
}

# Pluck value by index from a list (returns null if out of bounds or
# non-list).
@ public
fn get_index(value v, int index) → value {
    if v is null then return null
    if v not is list<value> then return null
    const list<value> items ← v ↦ list<value>
    const value got ← items.get(index)
    return got
}

# Find value by dotted path (e.g. "user.address.city"). Walks maps by
# key; numeric segments index lists. Returns null if any segment misses.
@ public
fn find(value v, string via) → value {
    # chorda.split_n limited split: at most via.length()+1 segments,
    # which is more than any dotted path can produce.
    const list<string> partes ← chorda.split_n(via, ".", via.length() + 1) ↦ list<string>
    var value current ← v
    for from partes const pars {
        current ← find_part(current, pars)
        if current is null then return null
    }
    return current
}

# Walk one path segment. Map-keyed first; numeric segments fall through
# to list indexing. Non-collection variants return null.
@ public
fn find_part(value current, string part) → value {
    if current is null then return null
    if current is map<string, value> {
        const map<string, value> tab ← current ↦ map<string, value>
        const value got ← tab.get(part)
        return got
    }
    if current is list<value> {
        do {
            const int idx ← part ↦ int
            return get_index(current, idx)
        }
        catch err {
            return null
        }
    }
    return null
}

# =========================================================================
# STRICT EXTRACTION
# =========================================================================

# Require a string child at clavis; throw on missing or non-string.
@ public
fn require_string(value v, string clavis) → string ⇥ string {
    const value child ← _get(v, clavis)
    if child is null then throw "missing key: §"(clavis)
    if child not is string then throw "key not textus: §"(clavis)
    return child ↦ string
}

# Require multiple string children; throws on the first missing or
# non-string key. Used by codec callers that validate a schema shape.
@ public
fn require_strings(value v, list<string> claves) → void ⇥ string {
    for from claves const clavis {
        const string _ ← require_string(v, clavis)
    }
    return
}
