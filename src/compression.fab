locale = "en"
+++

# compression.fab - Compression Device
#
# Etymology: compression — pressing / squeezing; Latin locale spelling `pressura`.
#
# Part of the host effect surface (gateway-dispatched `pressura:*` routes).

# Design notes:
# - compress: press data together
# - decompress: loosen/release compressed data
# - Algorithms: gzip, deflate, brotli, zstd
# - Levels: 1 (fast) to 9 (best compression)
# - Sync operations suitable for data <10MB
# - Streaming for large data

# =========================================================================
# ONE-SHOT OPERATIONS
# =========================================================================

# Compress bytes (optional level 1-9)
fn compress(string algorithm, bytes data, int level optional) → bytes {
    panic "norma:compression.compress is deferred pending Stage 2 dispatch"
}

# Decompress bytes
fn decompress(string algorithm, bytes data) → bytes {
    panic "norma:compression.decompress is deferred pending Stage 2 dispatch"
}

# =========================================================================
# STREAMING
# =========================================================================

# Create compression stream (optional level 1-9)
fn create_compressor(string algorithm, int level optional) → Compressor {
    panic "norma:compression.create_compressor is deferred pending Stage 2 dispatch"
}

# Create decompression stream
fn create_decompressor(string algorithm) → Decompressor {
    panic "norma:compression.create_decompressor is deferred pending Stage 2 dispatch"
}

# Compression stream
interface Compressor {
    # Write bytes in
    fn write_bytes(bytes data) → void

    # Close and get compressed result
    fn finish() → bytes
}

# Decompression stream
interface Decompressor {
    # Write compressed bytes in
    fn write_bytes(bytes data) → void

    # Read decompressed bytes out (partial)
    fn read_bytes() → bytes

    # Close and get final result
    fn finish() → bytes
}
