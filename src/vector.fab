+++
locale = "en"
+++

# vector.fab — compiler-owned vector register intrinsics
#
# Public import: importa ex "norma:vector" privata vector

fn addita<elem, size N>(vector<elem, N> a, vector<elem, N> b) → vector<elem, N> {
    return a.added(b)
}

fn subtrahe<elem, size N>(vector<elem, N> a, vector<elem, N> b) → vector<elem, N> {
    return a.subtract(b)
}

fn multiplica<elem, size N>(vector<elem, N> a, vector<elem, N> b) → vector<elem, N> {
    return a.multiply(b)
}

fn divida<elem, size N>(vector<elem, N> a, vector<elem, N> b) → vector<elem, N> {
    return a.divide(b)
}

fn productum<elem, size N>(vector<elem, N> a, vector<elem, N> b) → elem {
    return a.dot(b)
}

fn transversum<elem>(vector<elem, 3> a, vector<elem, 3> b) → vector<elem, 3> {
    return a.cross(b)
}

# NOTE: no generic `swizzle` wrapper here — the intrinsic's result width is
# the swizzle pattern length, which the typechecker cannot resolve for a
# `size N` receiver (SEM014 cannot_infer_tensor_shape). A fixed-width wrapper
# would lie about the pattern contract, so the intrinsic is left exposed
# until the shape-param gap closes.
