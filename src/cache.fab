+++
locale = "en"
+++

# thesaurus.fab - Cache and Pub/Sub Device
#
# Etymology: "thesaurus" - treasury, storehouse. A cache of values.
#
# Part of the host effect surface (gateway-dispatched `thesaurus:*` routes).
#
# Design notes:
# - Verb conjugation encodes sync/async:
# - Future (-et, -abit, -ent): async operations
# - Imperative: sync operations
# - Key-value cache with TTL
# - Pub/sub messaging with pattern subscriptions
# - In-memory for dev/single-node, Redis for production

# =========================================================================
# KEY-VALUE CACHE
# =========================================================================

# Get value by key (returns nihil if not found)
@ future
fn get(string key) → string ∪ null {
    panic "norma:thesaurus.get is deferred pending Stage 2 dispatch"
}

# Set value with optional TTL in seconds
@ future
fn put(string key, string value, int ttl) → void {
    panic "norma:thesaurus.put is deferred pending Stage 2 dispatch"
}

# Set value only if key doesn't exist
@ future
fn put_if_absent(string key, string value) → bool {
    panic "norma:thesaurus.put_if_absent is deferred pending Stage 2 dispatch"
}

# Delete key(s)
@ future
fn delete(list<string> keys) → int {
    panic "norma:thesaurus.delete is deferred pending Stage 2 dispatch"
}

# Check if key exists
@ future
fn exists(string key) → bool {
    panic "norma:thesaurus.exists is deferred pending Stage 2 dispatch"
}

# Get remaining TTL in seconds (-1 = no expiry, -2 = not found)
@ future
fn ttl(string key) → int {
    panic "norma:thesaurus.ttl is deferred pending Stage 2 dispatch"
}

# Set expiry on existing key
@ future
fn expire(string key, int secundae) → bool {
    panic "norma:thesaurus.expire is deferred pending Stage 2 dispatch"
}

# =========================================================================
# NUMERIC OPERATIONS
# =========================================================================

# Increment by amount (default 1)
@ future
fn increment(string key, int quantum) → int {
    panic "norma:thesaurus.increment is deferred pending Stage 2 dispatch"
}

# Decrement by 1
@ future
fn decrement(string key) → int {
    panic "norma:thesaurus.decrement is deferred pending Stage 2 dispatch"
}

# =========================================================================
# KEY QUERIES
# =========================================================================

# Find keys matching glob pattern
@ future
fn find_keys(string exemplar) → list<string> {
    panic "norma:thesaurus.find_keys is deferred pending Stage 2 dispatch"
}

# =========================================================================
# PUB/SUB
# =========================================================================

# Publish message to topic, returns subscriber count
@ future
fn publish(string topic, string nuntius) → int {
    panic "norma:thesaurus.publish is deferred pending Stage 2 dispatch"
}

# Subscribe to topic patterns
# Pattern: * matches one segment, ** matches multiple
@ future
fn subscribe(list<string> exemplaria) → Subscription {
    panic "norma:thesaurus.subscribe is deferred pending Stage 2 dispatch"
}

# Pub/Sub subscription
interface Subscription {
    # Iterate over incoming messages (async generator)
    @ future
    @ cursor
    fn messages() → cursor<Message>

    # Unsubscribe and cleanup
    fn close() → void
}

# Pub/Sub message
interface Message {
    fn topic() → string

    fn body() → string

    fn timestamp() → int
}
