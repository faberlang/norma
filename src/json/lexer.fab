+++
locale = "en"
+++

# json/lexer.fab — shared lexical floor for the JSON wire library
#
# Internal to norma:json. Imported by solve.fab (parser) and pange.fab (serializer).
# No Rust backing: pure Faber character classification and escape tables.
#
# Faber has no char type — a single character is a length-1 textus. Classifiers
# therefore compare length-1 slices using lexicographic ordering (the chorda
# retenta interval pattern) rather than calling an is_digit intrinsic.

# =========================================================================
# WHITESPACE
# =========================================================================

fn _is_whitespace(string c) → bool {
    return c ≡ " " or c ≡ "\t" or c ≡ "\n" or c ≡ "\r"
}

# Advance over whitespace; returns the next non-whitespace index.
fn _skip_whitespace(string s, int i) → int {
    var int pos ← i
    while pos < s.length() {
        if _is_whitespace(s.slice(pos, pos + 1)) {
            pos ← pos + 1
        }
        else {
            return pos
        }
    }
    return pos
}

# =========================================================================
# DIGITS / NUMBER TERMINATORS
# =========================================================================
# Faber has no char ordering (textus < is rejected as non-numeric), so digit
# classification uses membership against a literal digit string.

fn _is_digit(string c) → bool {
    return "0123456789".contains(c)
}

# A value terminator: the chars that legally end a scanned token.
fn _is_terminator(string c) → bool {
    return c ≡ "," or c ≡ "}" or c ≡ "]" or _is_whitespace(c)
}

# =========================================================================
# SERIALIZER ESCAPE TABLES
# =========================================================================
# _escape_char maps a single literal char to its backslash escape.
# Returns nihil when the char needs no escaping (caller emits it raw).

fn _escape_char(string c) → string ∪ null {
    if c ≡ "\"" then return "\\\""
    if c ≡ "\\" then return "\\\\"
    if c ≡ "\n" then return "\\n"
    if c ≡ "\r" then return "\\r"
    if c ≡ "\t" then return "\\t"
    if c ≡ "\u{08}" then return "\\b"
    if c ≡ "\u{0C}" then return "\\f"
    return null
}

# Does this char require backslash-escaping? The structural " and \ always
# do; other control chars (< space) are caught via _escape_char, which
# knows the named escapes (\n \r \t \b \f). LIMITATION: Faber has no ord
# intrinsic, so unnamed control chars (0x00-0x1F outside the named five)
# are not escaped — real JSON rarely carries them, but full RFC 8259
# compliance would require a \u00XX path and a codepoint intrinsic.
fn _needs_escape(string c) → bool {
    if c ≡ "\"" or c ≡ "\\" then return true
    if _escape_char(c) not is null then return true
    return false
}

# =========================================================================
# PARSER ESCAPE TABLE
# =========================================================================
# _unescape_char maps a single escape letter (the char following \) back
# to the literal it represents. Returns nihil for unknown letters (caller
# signals a syntax error) and treats "u" as a sentinel for \uXXXX handling.

fn _unescape_char(string s) → string ∪ null {
    if s ≡ "\"" then return "\""
    if s ≡ "\\" then return "\\"
    if s ≡ "/" then return "/"
    if s ≡ "n" then return "\n"
    if s ≡ "r" then return "\r"
    if s ≡ "t" then return "\t"
    if s ≡ "b" then return "\u{08}"
    if s ≡ "f" then return "\u{0C}"
    return null
}

# =========================================================================
# HEX DIGIT VALUE (for \uXXXX escapes)
# =========================================================================
# Single-hex-digit → numeric value. Returns nihil for non-hex chars.
# Plain lookup table: Faber has no ord intrinsic, so we enumerate.

fn _hex_value(string c) → int ∪ null {
    if c ≡ "0" then return 0
    if c ≡ "1" then return 1
    if c ≡ "2" then return 2
    if c ≡ "3" then return 3
    if c ≡ "4" then return 4
    if c ≡ "5" then return 5
    if c ≡ "6" then return 6
    if c ≡ "7" then return 7
    if c ≡ "8" then return 8
    if c ≡ "9" then return 9
    if c ≡ "a" or c ≡ "A" then return 10
    if c ≡ "b" or c ≡ "B" then return 11
    if c ≡ "c" or c ≡ "C" then return 12
    if c ≡ "d" or c ≡ "D" then return 13
    if c ≡ "e" or c ≡ "E" then return 14
    if c ≡ "f" or c ≡ "F" then return 15
    return null
}
