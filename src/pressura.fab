locale = "en"
+++

# pressura.fab - Compression Device
#
# Etymology: "pressura" - pressing, squeezing. Data compression.
#
# Part of the host effect surface (gateway-dispatched `pressura:*` routes).
#
# Design notes:
# - comprime (compress): press data together
# - solve (decompress): loosen/release compressed data
# - Algorithms: gzip, deflate, brotli, zstd
# - Levels: 1 (fast) to 9 (best compression)
# - Sync operations suitable for data <10MB
# - Streaming for large data

# =========================================================================
# ONE-SHOT OPERATIONS
# =========================================================================

# Compress bytes (optional level 1-9)
fn comprime(string algorithmus, bytes data, int nivel optional) → bytes {
    panic "norma:pressura.comprime is deferred pending Stage 2 dispatch"
}

# Decompress bytes
fn solve(string algorithmus, bytes data) → bytes {
    panic "norma:pressura.solve is deferred pending Stage 2 dispatch"
}

# =========================================================================
# STREAMING
# =========================================================================

# Create compression stream (optional level 1-9)
fn comprimens(string algorithmus, int nivel optional) → Compressor {
    panic "norma:pressura.comprimens is deferred pending Stage 2 dispatch"
}

# Create decompression stream
fn solvens(string algorithmus) → Decompressor {
    panic "norma:pressura.solvens is deferred pending Stage 2 dispatch"
}

# Compression stream
interface Compressor {
    # Pour data in
    fn funde(bytes data) → void

    # Close and get compressed result
    fn claude() → bytes
}

# Decompression stream
interface Decompressor {
    # Pour compressed data in
    fn funde(bytes data) → void

    # Draw decompressed data out (partial)
    fn hauri() → bytes

    # Close and get final result
    fn claude() → bytes
}
