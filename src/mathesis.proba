# Colocated stdlib test source for mathesis (public catalog).
# Not importable; discovered only by the faber test path (`include_proba`).
import from "./mathesis" mathesis

fn sum_pi(float x) → float {
    return mathesis.addita(mathesis.PI(), x)
}

describe "mathesis catalog" {
    test "PI is positive" {
        assert mathesis.PI() > 0.0
    }

    test "addita composes with PI helper" {
        assert sum_pi(0.0) ≡ mathesis.PI()
    }

    test "addita is commutative on unit" {
        assert mathesis.addita(1.0, 2.0) ≡ mathesis.addita(2.0, 1.0)
    }
}
